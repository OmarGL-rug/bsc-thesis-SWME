Cell[CellGroupData[{

Cell["2-dimensional system matrix with (u,v) in polar coordinates", \
"Subsection",
 CellChangeTimes->{{3.8453052837939186`*^9, 
  3.845305324949481*^9}},ExpressionUUID->"d7be2ce9-11f7-4e25-b474-\
4f6121d4f8ee"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
      RowBox[{"theta", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "}"}], "=", 
    RowBox[{"ToPolarCoordinates", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
       RowBox[{"v", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "}"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"SystemMatrixPolar", "=", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"XSystemMatrix", " ", "\[Beta]1"}], "+", 
       RowBox[{"YSystemMatrix", " ", "\[Beta]2"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], "->", 
        RowBox[{
         RowBox[{"r2", "[", 
          RowBox[{"t", ",", "x", ",", "y"}], "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"theta2", "[", 
           RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], "->", 
        RowBox[{
         RowBox[{"r2", "[", 
          RowBox[{"t", ",", "x", ",", "y"}], "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"theta2", "[", 
           RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}]}]}], "}"}]}]}], 
   ";", " ", "\[IndentingNewLine]", 
   RowBox[{"SystemMatrixPolar", "//", 
    RowBox[{"MatrixForm", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CharPolPolar", "[", "\[Lambda]_", "]"}], "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Expand", "[", 
        RowBox[{"CharacteristicPolynomial", "[", 
         RowBox[{"SystemMatrixPolar", ",", "\[Lambda]"}], "]"}], "]"}], 
       "]"}]}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CharPolPolar2", "[", "\[Lambda]_", "]"}], "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"CharPolPolar", "[", "\[Lambda]", "]"}], "/.", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Beta]1", "^", "2"}], "+", " ", 
        RowBox[{"\[Beta]2", "^", "2"}]}], "->", "1"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"eigenvaluesPolar", "=", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"CharPolPolar2", "[", "\[Lambda]", "]"}], "\[Equal]", "0"}], 
      ",", "\[Lambda]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.845305307739449*^9, 3.845305319493904*^9}, {
   3.8453054466875396`*^9, 3.845305493246063*^9}, {3.845305612427419*^9, 
