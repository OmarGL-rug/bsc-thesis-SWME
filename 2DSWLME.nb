Cell[BoxData[{
 RowBox[{
  RowBox[{"ACoefficients", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "i"}], "+", "1"}], ")"}], "*", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"j", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"k", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BCoefficients", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "i"}], "+", "1"}], ")"}], "*", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"LegendreP", "[", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], "]"}],
          "*", 
         RowBox[{"(", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"LegendreP", "[", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"2", "*", "xHat"}], "-", "1"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"xHat", ",", "0", ",", "x"}], "}"}]}], "]"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"LegendreP", "[", 
           RowBox[{"k", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Nx", ",", "Ny"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CCoefficients", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"LegendreP", "[", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], "]"}], 
        "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"LegendreP", "[", 
           RowBox[{"j", ",", 
            RowBox[{
             RowBox[{"2", "*", "x"}], "-", "1"}]}], "]"}], ",", "x"}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
