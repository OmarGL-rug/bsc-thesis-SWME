Cell["\<\
\\left(
\\begin{array}{ccccccc}
 0 & \\frac{2 i}{u} & 0 & 0 & 0 & 0 & 0 \\\\
 0 & -1+4 i & -1-\\frac{4 i}{3} & -1 & 0 & 0 & 0 \\\\
 4 i u & -3-4 i & -3+2 i & -3 & 0 & 0 & 0 \\\\
 0 & -5 & -5 & -5+2 i & 0 & 0 & 0 \\\\
 0 & 0 & 0 & 0 & -1+2 i & -1-\\frac{2 i}{3} & -1 \\\\
 0 & 0 & 0 & 0 & -3-2 i & -3+2 i & -3 \\\\
 0 & 0 & 0 & 0 & -5 & -5 & -5+2 i \\\\
\\end{array}
\\right)\
\>", "Output",
