       RowBox[{"LS", "[", 
        RowBox[{"Flatten", "[", "rhs", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"nx", ",", "ny"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
