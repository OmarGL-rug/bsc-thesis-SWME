               RowBox[{"nx", "+", "1"}]}], "}"}]}], "]"}]}], "]"}], "+", 
         "\[IndentingNewLine]", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Differences", "[", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "dy"]}], 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{
                "W", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                  "Htop", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "+", 
                  RowBox[{"Hbottom", "\[LeftDoubleBracket]", 
