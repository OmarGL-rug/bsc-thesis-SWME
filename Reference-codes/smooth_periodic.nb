          RowBox[{"PlusRecon", "[", 
           RowBox[{"H", ",", "\"\<Extrapolated\>\""}], "]"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"CMax", "=", 
       RowBox[{"ListConvolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", "/", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", "/", "2"}], "}"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"-", "1"}]], 
           RowBox[{"Abs", "[", "HU", "]"}]}], "+", 
          SqrtBox["H"]}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", "\"\<Fixed\>\""}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"JK", ":", " ", 
        RowBox[{
        "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
         "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dxHU", "=", 
