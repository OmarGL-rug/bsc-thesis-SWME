          RowBox[{
           RowBox[{"\[Kappa]Mean", ".", "#"}], "&"}], ",", "Uraw"}], "]"}], 
        ",", "1", ",", "\"\<Fixed\>\""}], "]"}], ",", "1"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uFullLL", "[", "ix", "]"}], "=", 
    RowBox[{"interpolate", "[", 
     RowBox[{
      RowBox[{"ArrayPad", "[", 
       RowBox[{"pts", ",", 
        RowBox[{"{", 
