Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"\[Chi]", "=", 
    SuperscriptBox["10", "6"]}], ";", "\[IndentingNewLine]", 
   RowBox[{"R", "=", "0.01"}], ";", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"FiniteVolumeRun", "[", 
    RowBox[{"nx", ",", "ny", ",", "tend"}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"JK", ":", " ", 
     RowBox[{
     "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
      "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Uraw", "=", 
    RowBox[{
     SuperscriptBox["Hraw", 
      RowBox[{"-", "1"}]], "HUraw"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"ix", "=", "1"}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hLL", "[", "ix", "]"}], "=", 
    RowBox[{"interpolate", "[", 
     RowBox[{
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
        "1", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{"Mean", ",", "Hraw"}], "]"}], ",", "1", ",", 
        "\"\<Fixed\>\""}], "]"}], ",", "1"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uMeanLL", "[", "ix", "]"}], "=", 
    RowBox[{"interpolate", "[", 
     RowBox[{
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
        "1", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{"Mean", ",", "Uraw"}], "]"}], ",", "1", ",", 
        "\"\<Fixed\>\""}], "]"}], ",", "1"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sLL", "[", "ix", "]"}], "=", 
    RowBox[{"interpolate", "[", 
     RowBox[{
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
        "1", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sMean", ".", "#"}], "&"}], ",", "Uraw"}], "]"}], ",", "1",
         ",", "\"\<Fixed\>\""}], "]"}], ",", "1"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Kappa]LL", "[", "ix", "]"}], "=", 
    RowBox[{"interpolate", "[", 
     RowBox[{
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
        "1", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
      RowBox[{"ArrayPad", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
