Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kappa", "[", "list_", "]"}], ":=", 
   RowBox[{"ArrayPad", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"list", "-", 
       RowBox[{"Mean", "[", "list", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"vertical", " ", "averaging", " ", "operator"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Residuum", "[", 
    RowBox[{"X_", ",", "H_", ",", "HU_", ",", "HV_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nx", ",", "ny", ",", "Hleft", ",", "Hright", ",", "HUleft", ",", 
       "HUright", ",", "HVleft", ",", "HVright", ",", "U", ",", "V", ",", 
       "HUbottom", ",", "HUtop", ",", "HVbottom", ",", "HVtop", ",", 
       "Hbottom", ",", "Htop", ",", "dxHU", ",", "WForcingTerm", ",", " ", 
       "WIntegrand", ",", "W", ",", "CMax", ",", 
       RowBox[{"delta", "=", "0.95"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nx", ",", "ny"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "HU", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "HUleft", ",", "HVleft", ",", "Hleft", ",", "HUright", ",", "HVright",
          ",", "Hright", ",", "HUbottom", ",", "HVbottom", ",", "Hbottom", 
         ",", "HUtop", ",", "HVtop", ",", "Htop"}], "}"}], "=", 
       RowBox[{"Parallelize", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"MinusRecon", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "HU", "]"}], ",", "\"\<Fixed\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"(*", 
           RowBox[{"JK", ":", " ", 
            RowBox[{
            "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
             "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"MinusRecon", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "HV", "]"}], ",", "\"\<Fixed\>\""}], 
           "]"}], ",", " ", 
          RowBox[{"(*", 
           RowBox[{"JK", ":", " ", 
            RowBox[{
            "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
             "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"MinusRecon", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "H", "]"}], ",", "\"\<Fixed\>\""}], 
           "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"JK", ":", " ", 
            RowBox[{
            "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
             "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"PlusRecon", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "HU", "]"}], ",", "\"\<Fixed\>\""}], 
           "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"JK", ":", " ", 
            RowBox[{
            "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
             "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"PlusRecon", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "HV", "]"}], ",", "\"\<Fixed\>\""}], 
           "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"JK", ":", " ", 
            RowBox[{
            "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
             "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"PlusRecon", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "H", "]"}], ",", "\"\<Fixed\>\""}], 
           "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{"JK", ":", " ", 
            RowBox[{
            "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
             "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"MinusRecon", "[", 
           RowBox[{"HU", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MinusRecon", "[", 
           RowBox[{"HV", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MinusRecon", "[", 
           RowBox[{"H", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlusRecon", "[", 
           RowBox[{"HU", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlusRecon", "[", 
           RowBox[{"HV", ",", "\"\<Extrapolated\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlusRecon", "[", 
           RowBox[{"H", ",", "\"\<Extrapolated\>\""}], "]"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"XPadded", "=", 
         RowBox[{"ArrayPad", "[", 
          RowBox[{"X", ",", "2", ",", "\"\<Extrapolated\>\"", ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"CMax", "=", 
       RowBox[{"ListConvolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", "/", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", "/", "2"}], "}"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["H", 
            RowBox[{"-", "1"}]], 
           RowBox[{"Abs", "[", "HU", "]"}]}], "+", 
          SqrtBox["H"]}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", "\"\<Fixed\>\""}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"JK", ":", " ", 
        RowBox[{
        "boundary", " ", "values", " ", "now", " ", "extrapolated", " ", 
         "constantly", " ", "from", " ", "interior"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dxHU", "=", 
       RowBox[{"Differences", "[", 
