           RowBox[{
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "HUright", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "+", 
               RowBox[{"HUleft", "\[LeftDoubleBracket]", 
                RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ")"}]}],
             "+", 
            RowBox[{
             FractionBox["delta", "2"], 
             RowBox[{
             "CMax", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "Hright", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "-", 
               RowBox[{"Hleft", "\[LeftDoubleBracket]", 
                RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], 
              ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"nx", "+", "1"}]}], "}"}]}], "]"}]}], "]"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WForcingTerm", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"X", "[", 
              RowBox[{"[", "i", "]"}], "]"}]], 
            FractionBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "HUleft", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "+", 
               RowBox[{"HUright", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "2"]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nx"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WIntegrand", " ", "=", " ", 
       RowBox[{"dxHU", " ", "+", " ", "WForcingTerm"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"W", "=", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
