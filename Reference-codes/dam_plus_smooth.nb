            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{
                "W", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
