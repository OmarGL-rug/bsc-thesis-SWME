            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "momentsRight"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"moment", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"momentReference", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Choose", " ", "time", " ", "step"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dt", "=", 
        RowBox[{"0.1", "dx"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrix", "[", 
        RowBox[{
        "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", 
         "momentsLeft", ",", "momentsRight", ",", "Relaxation", ",", "dt"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrixReference", "[", 
