Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ConstructMatrixReference", "[", 
     RowBox[{
     "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "dx_", ",", 
      "momentsLeft_", ",", "momentsRight_", ",", "Relaxation_", ",", "dt_"}], 
     "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ARight", ",", "QRight", ",", "Roe", ",", "Viscosity"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"AS", " ", "REFERENCE", " ", "SOLUTION"}], ",", " ", 
        RowBox[{
        "WE", " ", "CONSIDER", " ", "THE", " ", "SOLUTION", " ", "WE", " ", 
         "OBTAIN", " ", "BY", " ", "TAKING", " ", "THE", " ", "BIGGER", " ", 
         "MATRIX", " ", "EVERYWHERE"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ARight", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
              RowBox[{
               RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
             RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
              RowBox[{
               RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
             RowBox[{"Sqrt", "[", "i", "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"QRight", "=", 
        RowBox[{"IdentityMatrix", "[", "momentsRight", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"RoeReference", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityReference", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
         "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
