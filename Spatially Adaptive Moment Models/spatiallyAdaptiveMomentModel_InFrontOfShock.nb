        RowBox[{"WrawReference", ",", 
         RowBox[{"valuesReference", "[", "nxL", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"nxL", "+", "1"}]}], ",", 
        RowBox[{"i", "<", 
         RowBox[{"nxL", "+", "positionInFrontOfShock"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"values", "[", "i", "]"}], "=", 
          "initialValuesIntermediate"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Wraw", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"Wraw", ",", 
            RowBox[{"values", "[", "i", "]"}]}], "]"}]}], ";", 
