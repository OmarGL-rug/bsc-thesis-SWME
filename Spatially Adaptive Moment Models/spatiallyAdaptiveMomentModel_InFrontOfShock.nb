Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitializeVector", "[", 
    RowBox[{
    "initialValuesLeft_", ",", "initialValuesRight_", ",", "epsilon_", ",", 
     "momentsBig_", ",", "momentsLeft_", ",", "momentsRight_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "momentSmall", ",", "initialValuesLeft2", ",", 
       "initialValuesIntermediate", ",", "initialValuesRight2", ",", 
       "initialValuesLeftReference", ",", "initialValuesRightReference", ",", 
       "values", ",", "valuesReference"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"momentSmall", "=", "epsilon"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesLeft2", "=", "initialValuesLeft"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesIntermediate", "=", "initialValuesLeft"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesRight2", "=", "initialValuesRight"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesLeftReference", " ", "=", "initialValuesLeft"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"initialValuesRightReference", "=", "initialValuesRight"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsLeft"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"initialValuesLeft2", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesLeft2", ",", "momentsBig"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"initialValuesIntermediate", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesIntermediate", ",", "momentsBig"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"initialValuesRight2", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRight2", ",", "momentsBig"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"initialValuesLeftReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesLeftReference", ",", "momentsBig"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"initialValuesRightReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRightReference", ",", "momentsBig"}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"momentsLeft", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"initialValuesIntermediate", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesIntermediate", ",", "momentSmall"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"initialValuesRight2", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRight2", ",", "momentSmall"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"initialValuesLeftReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesLeftReference", ",", "momentSmall"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"initialValuesRightReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRightReference", ",", "momentSmall"}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Construct", " ", "initial", " ", "vector"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Wraw", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"WrawReference", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "nxL"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"values", "[", "i", "]"}], "=", "initialValuesLeft2"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Wraw", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"Wraw", ",", 
            RowBox[{"values", "[", "i", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"valuesReference", "[", "i", "]"}], "=", 
          "initialValuesLeftReference"}], ";", "\[IndentingNewLine]", 
         RowBox[{"WrawReference", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"WrawReference", ",", 
            RowBox[{"valuesReference", "[", "i", "]"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"values", "[", "nxL", "]"}], "=", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"initialValuesLeft2", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "numberOfMomentsDifference"}], "}"}]}], "]"}]}], 
      ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Take", " ", "initial", " ", "values", " ", "from", " ", "the", " ", 
        "left", " ", "and", " ", "add", " ", "zeroes"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Wraw", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"Wraw", ",", 
         RowBox[{"values", "[", "nxL", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"valuesReference", "[", "nxL", "]"}], "=", 
