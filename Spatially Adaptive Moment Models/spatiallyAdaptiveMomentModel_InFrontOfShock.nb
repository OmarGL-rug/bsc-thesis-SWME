Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InitializeModel", "[", 
     RowBox[{
     "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
      "momentsRight_", ",", "initialValuesLeft_", ",", "initialValuesRight_", 
      ",", "epsilon_", ",", "momentsBig_", ",", "Relaxation_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx", ",", "values", ",", "valuesReference"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"numberOfMomentsDifference", "=", 
        RowBox[{"momentsRight", "-", "momentsLeft"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"nxL", "+", "nxR"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"positionInFrontOfShock", "=", 
        RowBox[{"Round", "[", 
         FractionBox["n", "10"], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dx", "=", 
        FractionBox[
         RowBox[{"x2", "-", "x1"}], "n"]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"InitializeVector", "[", 
        RowBox[{
        "initialValuesLeft", ",", "initialValuesRight", ",", "epsilon", ",", 
         "momentsBig", ",", "momentsLeft", ",", "momentsRight"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Initialize", " ", "the", " ", "collection", " ", "of", " ", "the", 
         " ", "moments"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"moments", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsReference", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentReference", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsLoop", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsReferenceLoop", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentReferenceLoop", "[", "i", "]"}], ",", 
          RowBox[{"{", 
