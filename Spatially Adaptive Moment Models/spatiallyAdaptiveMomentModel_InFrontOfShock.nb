Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeScheme", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "norm", ",", "normRemainder", ",", "WeightedSumRoe", ",", 
       "WeightedSumViscosity", ",", "modelDiffA", ",", "modelDiffQ"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeSpatiallyAdaptive", ",", "outputSpatiallyAdaptive"}], 
        "}"}], "=", "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Compute", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
            "point", " ", "s0", " ", "along", " ", "the", " ", "path"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "1"}], ",", 
              RowBox[{"i", "<=", "momentsLeft"}], ",", 
              RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"norm", "+=", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"W", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", "i"}], "]"}], 
                    "]"}], "-", 
                   RowBox[{"W", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", 
                    "+", "i"}], "]"}], "]"}]}], ")"}], "2"]}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"normRemainder", "=", "0"}], ";", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{"momentsLeft", "+", "1"}]}], ",", 
              RowBox[{"i", "<=", "momentsRight"}], ",", 
              RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"normRemainder", "+=", 
                SuperscriptBox[
                 RowBox[{"W", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", 
                    "+", "i"}], "]"}], "]"}], "2"]}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
                RowBox[{"Sqrt", "[", "normRemainder", "]"}]}], "==", "0"}], 
              ",", 
              RowBox[{"s0", "=", "0"}], ",", 
              RowBox[{"s0", "=", 
               FractionBox[
                RowBox[{"Sqrt", "[", "norm", "]"}], 
                RowBox[{
                 RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
