Cell[CellGroupData[{

Cell["Construction matrix", "Subsection",
 CellChangeTimes->{{3.9017841319224734`*^9, 
  3.9017841378094378`*^9}},ExpressionUUID->"89cc3ebd-c48e-46b2-8971-\
cccb0bd35132"],

Cell["\<\
Construction of the Roe matrix and the viscosity matrix for the reference \
system.\
\>", "Text",
 CellChangeTimes->{{3.903860817007146*^9, 3.9038608340900097`*^9}},
 FontSize->16,ExpressionUUID->"5a074479-24fd-4ec1-b215-0b5ce6359bce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ConstructMatrixReference", "[", 
     RowBox[{
     "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "dx_", ",", 
      "momentsLeft_", ",", "momentsRight_", ",", "dt_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"RoeReferenceBlock", ",", "ViscosityReferenceBlock"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeReferenceBlock", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityReferenceBlock", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
         "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "All", " ", "rows", " ", "apart", " ", "from", " ", "the", " ", 
         "first", " ", "and", " ", "the", " ", "last"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"n", "+", "1"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "ARight"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "ARight"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"2", "*", "QRight"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<", 
             RowBox[{"i", "-", "1"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeReferenceBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
