Cell["Source Term", "Subsection",
 CellChangeTimes->{{3.9026439467348037`*^9, 3.902643953751412*^9}, {
  3.9026453663618517`*^9, 3.902645369247607*^9}, {3.9026464090009727`*^9, 
  3.90264640931116*^9}},ExpressionUUID->"40e27119-123f-4402-bc6b-\
a2986589571f"],

Cell[TextData[StyleBox["Computation of source term.",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.9164780111337566`*^9, 3.9164780178645306`*^9}, {
  3.9200044622721977`*^9, 
  3.920004462364504*^9}},ExpressionUUID->"83ff3a19-f5dc-4dad-b6a1-\
24927444be2d"],

Cell[CellGroupData[{

Cell["Extended vector models", "Subsubsection",
 CellChangeTimes->{{3.916476854846704*^9, 
  3.9164768579459057`*^9}},ExpressionUUID->"afa383b5-c79e-44be-83ca-\
16117fda8dfa"],

Cell["\<\
Construction of the source term matrix for the models using the extended \
vector.\
\>", "Text",
 CellChangeTimes->{{3.903854433884282*^9, 3.9038544491965017`*^9}, {
  3.916476834003949*^9, 3.91647684392305*^9}},
 FontSize->16,ExpressionUUID->"cf8df730-a9ef-4a49-a47a-43c063aab5b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTerm", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
     "momentsRight_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "SourceTermVectorLeft", ",", "SourceTermVectorRight", ",", 
       "SourceTermVector"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceTermVectorLeft", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorRight", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsLeft"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorLeft", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorLeft", ",", "1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"momentsLeft", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", 
         RowBox[{"nxL", "-", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"SourceTermVector", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"SourceTermVector", ",", "SourceTermVectorLeft"}], 
            "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"Relaxation", "[", 
               RowBox[{"xs", "[", "i", "]"}], "]"}]], "*", 
             "SourceTermVectorLeft"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"nxL", "-", "1"}]}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"Relaxation", "[", 
               RowBox[{"xs", "[", "i", "]"}], "]"}]], "*", 
             "SourceTermVectorRight"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "matrix"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrix", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVector", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixExp", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9026443436550684`*^9, 3.902644349713498*^9}, {
   3.90264439035752*^9, 3.90264445232934*^9}, {3.9026447547300086`*^9, 
   3.9026448094880157`*^9}, {3.9026450398203893`*^9, 3.902645041707831*^9}, 
   3.9026468582274456`*^9, {3.902647155618944*^9, 3.9026471583085127`*^9}, {
   3.902650460498855*^9, 3.9026504791238303`*^9}, {3.902651071332897*^9, 
   3.9026510725840483`*^9}, {3.902823517069681*^9, 3.9028235261578703`*^9}, {
   3.902824060423334*^9, 3.9028240655638695`*^9}, {3.9028241564725556`*^9, 
   3.9028241567584553`*^9}, {3.902824565531398*^9, 3.9028245656674848`*^9}, {
   3.902824650298018*^9, 3.902824650695034*^9}, {3.9048077701105986`*^9, 
   3.9048077755876284`*^9}, {3.9048090132741804`*^9, 
   3.9048090436143413`*^9}, {3.9048092235244427`*^9, 3.904809224045024*^9}, {
   3.904809776633191*^9, 3.9048097856046557`*^9}, {3.90481120009394*^9, 
   3.904811202011631*^9}, {3.928467424720708*^9, 3.928467553969041*^9}, {
   3.9312312873653727`*^9, 3.9312313033142357`*^9}, {3.9312314515941873`*^9, 
   3.9312314597777624`*^9}, {3.9312315109823675`*^9, 3.9312315713182817`*^9}, 
   3.9312324655044813`*^9, {3.931236585142211*^9, 3.931236586531751*^9}, {
   3.932187128253154*^9, 3.9321871634059215`*^9}, {3.9321880733057747`*^9, 
   3.9321880923680887`*^9}, {3.9322011377594757`*^9, 3.932201164384019*^9}, {
   3.9322012521047134`*^9, 3.932201265634283*^9}, {3.932201573399789*^9, 
   3.932201586556136*^9}, 3.9322029931963253`*^9, {3.9322101129758377`*^9, 
   3.9322101250790315`*^9}},ExpressionUUID->"b32edb5d-b82f-449d-a8c0-\
7a4ab44a356c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Non-square matrix models", "Subsubsection",
 CellChangeTimes->{{3.91647686679144*^9, 
  3.916476877499366*^9}},ExpressionUUID->"c13df3a1-f017-44e8-a895-\
2e7266c3169d"],

Cell["\<\
Construction of the source term for the model that used non-square matrices.\
\>", "Text",
 CellChangeTimes->{{3.9164779827800264`*^9, 
  3.916477997909968*^9}},ExpressionUUID->"a8decaf9-2eca-4523-9634-\
b090a56001ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTermNonSquare", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
     "momentsRight_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "SourceMatrixLeft", ",", "SourceMatrixRight", ",", 
       "SourceTermVectorLeft", ",", "SourceTermVectorRight", ",", 
       "SourceTermVector"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "the", " ", "RHS", " ", "source", " ", "term"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "assume", " ", "a", " ", "BGK"}], "-", 
        RowBox[{
        "type", " ", "operator", " ", "and", " ", "we", " ", "assume", " ", 
         "that", " ", "the", " ", "source", " ", "term", " ", "matrix", " ", 
         "is", " ", "a", " ", "diagonal", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceMatrixLeft", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "i_"}], "}"}], "/;", 
            RowBox[{"i", ">=", "4"}]}], "\[RuleDelayed]", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceMatrixRight", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "i_"}], "}"}], "/;", 
            RowBox[{"i", ">=", "4"}]}], "\[RuleDelayed]", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorLeft", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorRight", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsLeft"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorLeft", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorLeft", ",", "1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"momentsLeft", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", 
         RowBox[{"nxL", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"Relaxation", "[", 
               RowBox[{"xs", "[", "i", "]"}], "]"}]], "*", 
             "SourceTermVectorLeft"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"nxL", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"Relaxation", "[", 
               RowBox[{"xs", "[", "i", "]"}], "]"}]], "*", 
             "SourceTermVectorRight"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "matrix"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixNonSquare", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVector", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixNonSquareExp", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9164770546297903`*^9, 3.916477056152053*^9}, {
   3.9164771312992697`*^9, 3.9164771314013367`*^9}, {3.916477172673423*^9, 
   3.9164771770102935`*^9}, {3.9164776096977286`*^9, 
   3.9164776175789237`*^9}, {3.9164778450660048`*^9, 
   3.9164778640476108`*^9}, {3.9164778979846582`*^9, 3.916477949176943*^9}, {
   3.9312318668001747`*^9, 3.9312319028270707`*^9}, 3.931232478726731*^9, {
   3.932186191078508*^9, 3.932186229612897*^9}, {3.932186330285102*^9, 
   3.9321863463208055`*^9}, {3.932186396385851*^9, 3.9321864360612397`*^9}, 
   3.9321864704336605`*^9, {3.9321865212819915`*^9, 3.9321865916053324`*^9}, {
   3.9322011923223343`*^9, 3.9322011992359366`*^9}, {3.932201276541548*^9, 
   3.932201326115985*^9}, {3.932201563491973*^9, 3.932201563899364*^9}, {
   3.932201628553589*^9, 3.9322016448396606`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"b87e1c70-fc97-4822-9ab5-06e79c47b8ce"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Construction of model at the interface between the two subdomains\
\>", "Subsection",
 CellChangeTimes->{{3.903436918942368*^9, 
  3.9034369406005497`*^9}},ExpressionUUID->"bf4dd770-ccfa-47c1-aee5-\
ebaa7a6eba67"],

Cell["\<\
There are different options for the model we use in the cell directly right \
of the interface between the left and the right subdomains, in which a \
different number of moments is used. \
\>", "Text",
 CellChangeTimes->{{3.9038550177270308`*^9, 3.9038551251558237`*^9}},
 FontSize->16,ExpressionUUID->"0b0f4337-feb9-452c-ad3f-fcf4eaca9f71"],

Cell[CellGroupData[{

Cell["Using a modified system matrix at the boundary interface ", \
"Subsubsection",
 CellChangeTimes->{{3.9034371145258856`*^9, 3.903437128087574*^9}, {
   3.9217312835213366`*^9, 3.921731315544826*^9}, 3.9217313592016826`*^9, {
   3.9285063795612345`*^9, 
   3.9285063888491535`*^9}},ExpressionUUID->"662bc9e1-545b-4a87-a265-\
c4b5ed0f1192"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Here", " ", "we", " ", "use", " ", "a", " ", "modified", " ", "Roe", " ", 
    "linearization", " ", "at", " ", "the", " ", "boundary", " ", 
    "interface"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"modifiedRoeMatrixAtInterface", "[", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"RoeModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "ARight"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", "ARight"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ViscosityModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ViscosityModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
       RowBox[{"2", "*", "QRight"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ViscosityModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", 
       RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeModifiedBlockMatrix", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "1"}], ",", "nxL"}], "]"}], "]"}], "=", 
       RowBox[{"-", 
        RowBox[{"ArrayPad", "[", 
         RowBox[{"ALeft", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "numberOfMomentsDifference"}], "}"}], ",", 
            RowBox[{"{", 
