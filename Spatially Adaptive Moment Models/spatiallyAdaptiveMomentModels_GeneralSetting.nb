Cell[CellGroupData[{

Cell["Construction matrix", "Subsection",
 CellChangeTimes->{{3.9017841319224734`*^9, 
  3.9017841378094378`*^9}},ExpressionUUID->"a4cf8c49-7544-40ca-aa42-\
ef40b44641a8"],

Cell["\<\
Construction of the Roe matrix and the viscosity matrix for the reference \
system.\
\>", "Text",
 CellChangeTimes->{{3.903860817007146*^9, 3.9038608340900097`*^9}},
 FontSize->16,ExpressionUUID->"83ee6d6a-acae-46a6-ba49-f3dbe76004c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ConstructMatrixReference", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "RoeReferenceBlock", ",", "ViscosityReferenceBlock", ",", "A", ",", 
        "Q"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeReferenceBlock", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityReferenceBlock", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
         "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
              RowBox[{
               RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]",
              "1"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
              RowBox[{
               RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]",
              "i"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Q", "=", 
        RowBox[{"IdentityMatrix", "[", "MaxMoment", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "All", " ", "rows", " ", "apart", " ", "from", " ", "the", " ", 
         "first", " ", "and", " ", "the", " ", "last"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"n", "+", "1"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "A"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "A"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "Q"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"2", "*", "Q"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "Q"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<", 
             RowBox[{"i", "-", "1"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeReferenceBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ViscosityReferenceBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "2"}]}], ",", 
            RowBox[{"j", "<=", 
             RowBox[{"n", "+", "2"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeReferenceBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ViscosityReferenceBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Last", " ", "rows", " ", "are", " ", "ghost", " ", "rows"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "+", "2"}], ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReferenceBlock", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "+", "2"}], ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MaxMoment", ",", "MaxMoment"}], "}"}]}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Call", " ", "the", " ", "method", " ", "that", " ", "constructs", 
         " ", "the", " ", "source", " ", "term", " ", "for", " ", "the", " ", 
         "reference", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ConstructSourceTermReference", "[", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Obtain", " ", "full", " ", "Roe", " ", "matrix", " ", "and", " ", 
         "full", " ", "viscosity", " ", "matrix", " ", "from", " ", "their", 
         " ", "block", " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"RoeReference", " ", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "RoeReferenceBlock", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityReference", " ", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "ViscosityReferenceBlock", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Obtain", " ", "transport", " ", "part", " ", "of", " ", "spatial", 
         " ", "discretization", " ", "matrix", " ", "for", " ", "the", " ", 
         "reference", " ", "system", " ", "from", " ", "Roe", " ", "block", 
         " ", "matrix", " ", "and", " ", "viscosity", " ", "block", " ", 
         "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BigAMatrixReferenceBlock", "=", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1.0", 
           RowBox[{"2", "*", "dx"}]]}], "*", 
         RowBox[{"(", 
          RowBox[{"RoeReferenceBlock", "+", "ViscosityReferenceBlock"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"BigAMatrixReference", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1.0", 
           RowBox[{"2", "*", "dx"}]]}], "*", 
         RowBox[{"(", 
          RowBox[{"RoeReference", "+", "ViscosityReference"}], ")"}]}]}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
