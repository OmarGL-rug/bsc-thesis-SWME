  3.931581703283572*^9}},ExpressionUUID->"2540ee63-971c-4da1-b63d-\
4f3f2b352958"],

Cell["\<\
Time stepping method for the low-order numerical approximation.\
\>", "Text",
 CellChangeTimes->{{3.9038685249310627`*^9, 3.903868545812598*^9}, 
   3.9038686791790977`*^9, {3.9315816780920334`*^9, 3.9315816863794613`*^9}},
 FontSize->16,ExpressionUUID->"47f3530a-0b1a-476a-a296-627ba6d5d474"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeLowOrder", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WLowOrder", "=", "WrawLowOrder"}], ";", "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeLowOrder", ",", "outputLowOrder"}], "}"}], "=", 
       "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
            "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
            "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"WLowOrder", "=", 
            RowBox[{"WLowOrder", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixLowOrder", ".", "WLowOrder"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"WLowOrder", "=", 
            RowBox[{"SourceTermMatrixLowOrderExp", ".", "WLowOrder"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "MinMoment"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "MinMoment"}], "]"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"MinMoment", "*", "nxL"}], "+", 
                  RowBox[{"MinMoment", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"MinMoment", "*", "nxL"}], "+", 
                  RowBox[{"MinMoment", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "collection", " ", "of", " ", "each", " ", 
             "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "MinMoment"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"n", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"j", "=", "0"}], ",", 
                RowBox[{"j", "<", "MinMoment"}], ",", 
                RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{
                    RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                    RowBox[{"WLowOrder", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"MinMoment", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "MinMoment"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLowOrder", "[", "i", "]"}], "=", " ", 
               RowBox[{"momentLoop", "[", "i", "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "MinMoment"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLowOrderSum", "[", "i", "]"}], "=", 
               RowBox[{"Total", "[", 
                RowBox[{"momentLowOrder", "[", "i", "]"}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
               RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", 
             " ", 
             RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
             RowBox[{"f2", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"\[Sqrt]", "2"}]], 
               RowBox[{"(", 
                RowBox[{"\[Rho]T", "+", 
                 SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"densityLowOrder", "=", 
            RowBox[{"momentLowOrder", "[", "0", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"velocityLowOrder", "=", 
            FractionBox[
             RowBox[{"momentLowOrder", "[", "1", "]"}], "densityLowOrder"]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"temperatureLowOrder", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"\[Sqrt]", "2"}], "*", 
               RowBox[{"momentLowOrder", "[", "2", "]"}]}], "-", 
              RowBox[{
              "densityLowOrder", "*", "velocityLowOrder", "*", 
               "velocityLowOrder"}], "+", "densityLowOrder"}], 
             "densityLowOrder"]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"time", " ", "=", " ", 
            RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.902810517096759*^9, {3.90281064731122*^9, 3.902810654867694*^9}, {
   3.903868682582562*^9, 3.9038687215765476`*^9}, {3.9228677573162155`*^9, 
   3.9228677676322527`*^9}, 3.9228683256545196`*^9, {3.928555150052086*^9, 
   3.928555151153846*^9}, {3.931581362933756*^9, 3.9315815866514235`*^9}, {
   3.932202601582549*^9, 3.9322026021076508`*^9}, {3.9379097772360935`*^9, 
   3.937909829548212*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"d7937c0c-52f0-449e-a7df-68d4b4e1cdbb"]
}, Closed]],

