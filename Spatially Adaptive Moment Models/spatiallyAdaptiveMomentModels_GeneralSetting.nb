Cell[CellGroupData[{

Cell["Construction matrix", "Subsection",
 CellChangeTimes->{{3.9017841319224734`*^9, 
  3.9017841378094378`*^9}},ExpressionUUID->"84bfb3de-6124-4f8c-aac7-\
3e39ff60f488"],

Cell["\<\
Construction of the Roe matrix and the viscosity matrix for the low-order \
numerical approximation.\
\>", "Text",
 CellChangeTimes->{{3.903860817007146*^9, 3.9038608340900097`*^9}, {
  3.9315810944186163`*^9, 3.931581100633932*^9}},
 FontSize->16,ExpressionUUID->"fe2b089d-05b6-4d81-8e85-a03ac1bdc025"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ConstructMatrixLowOrder", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "RoeLowOrderBlock", ",", "ViscosityLowOrderBlock", ",", "A", ",", 
        "Q"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeLowOrderBlock", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityLowOrderBlock", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
         "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
              RowBox[{
               RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]",
              "1"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
              RowBox[{
               RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]",
              "i"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Q", "=", 
        RowBox[{"IdentityMatrix", "[", "MinMoment", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "All", " ", "rows", " ", "apart", " ", "from", " ", "the", " ", 
         "first", " ", "and", " ", "the", " ", "last"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"n", "+", "1"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "A"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "A"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "Q"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"2", "*", "Q"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "Q"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<", 
             RowBox[{"i", "-", "1"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeLowOrderBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ViscosityLowOrderBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "2"}]}], ",", 
            RowBox[{"j", "<=", 
             RowBox[{"n", "+", "2"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeLowOrderBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ViscosityLowOrderBlock", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Last", " ", "rows", " ", "are", " ", "ghost", " ", "rows"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "+", "2"}], ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityLowOrderBlock", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "+", "2"}], ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"MinMoment", ",", "MinMoment"}], "}"}]}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Call", " ", "the", " ", "method", " ", "that", " ", "constructs", 
         " ", "the", " ", "source", " ", "term", " ", "for", " ", "the", " ", 
         "reference", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ConstructSourceTermLowOrder", "[", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Obtain", " ", "full", " ", "Roe", " ", "matrix", " ", "and", " ", 
         "full", " ", "viscosity", " ", "matrix", " ", "from", " ", "their", 
         " ", "block", " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"RoeLowOrder", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "RoeLowOrderBlock", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityLowOrder", " ", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "ViscosityLowOrderBlock", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Obtain", " ", "transport", " ", "part", " ", "of", " ", "spatial", 
         " ", "discretization", " ", "matrix", " ", "for", " ", "the", " ", 
         "reference", " ", "system", " ", "from", " ", "Roe", " ", "block", 
         " ", "matrix", " ", "and", " ", "viscosity", " ", "block", " ", 
         "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BigAMatrixLowOrderBlock", "=", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1.0", 
           RowBox[{"2", "*", "dx"}]]}], "*", 
         RowBox[{"(", 
          RowBox[{"RoeLowOrderBlock", "+", "ViscosityLowOrderBlock"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"BigAMatrixLowOrder", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1.0", 
           RowBox[{"2", "*", "dx"}]]}], "*", 
         RowBox[{"(", 
          RowBox[{"RoeLowOrder", "+", "ViscosityLowOrder"}], ")"}]}]}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9017139504548087`*^9, 3.90171396683692*^9}, {
