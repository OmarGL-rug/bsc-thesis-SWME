Cell[CellGroupData[{

Cell["Domain decomposition", "Subsection",
 CellChangeTimes->{{3.936866335573209*^9, 
  3.9368663406205215`*^9}},ExpressionUUID->"8a6a2e93-095e-4a26-8794-\
a6184d1f093b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DomainDecomposition", "[", "domainDecompositionList_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DiscretizedDomainDecomposition", "=", 
      RowBox[{"List", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"DiscretizedDomainDecomposition", ",", 
       RowBox[{"Round", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"domainDecompositionList", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "x1"}], ")"}], 
          RowBox[{"x2", "-", "x1"}]], "*", "n"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "2"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "domainDecompositionList", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"DiscretizedDomainDecomposition", ",", 
          RowBox[{
           RowBox[{"DiscretizedDomainDecomposition", "[", 
            RowBox[{"[", 
             RowBox[{"i", "-", "1"}], "]"}], "]"}], "+", 
           RowBox[{"Round", "[", 
            RowBox[{
             FractionBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"domainDecompositionList", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", 
                RowBox[{"domainDecompositionList", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}], 
              RowBox[{"x2", "-", "x1"}]], "*", "n"}], "]"}]}]}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"DiscretizedDomainDecomposition", ",", "n"}], "]"}], ";"}], 
    "\[IndentingNewLine]", ")"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.937902519166115*^9, 3.937902519281616*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"5b63a6c5-68f3-4535-bffe-92f6771152ca"]
}, Open  ]],

Cell[CellGroupData[{

