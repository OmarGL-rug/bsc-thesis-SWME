            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", 
                  RowBox[{"(", 
                   RowBox[{"nxL", "+", "1"}], ")"}]}], "+", 
                 RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
