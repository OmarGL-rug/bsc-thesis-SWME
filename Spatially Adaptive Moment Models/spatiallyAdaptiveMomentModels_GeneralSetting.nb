Cell["\<\
As reference solution, we consider the numerical solution we obtain if we \
used the bigger matrix in the whole domain. \
\>", "Text",
 CellChangeTimes->{{3.903860577380809*^9, 3.9038606035230646`*^9}},
 FontSize->18,ExpressionUUID->"a2c59cd8-f4e0-4cda-9f8f-c9a2a4a78e2c"],

Cell[CellGroupData[{

Cell["Source Term", "Subsection",
 CellChangeTimes->{{3.9026464043234673`*^9, 
  3.9026464070493793`*^9}},ExpressionUUID->"46288c83-2536-4165-a481-\
c566029f17d1"],

Cell["\<\
Construction of the source term matrix for the reference system.\
\>", "Text",
 CellChangeTimes->{{3.9038607733774614`*^9, 3.903860781079492*^9}},
 FontSize->16,ExpressionUUID->"f75f92ed-814b-4aec-a69b-bac74253fd64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTermReference", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
     "momentsRight_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"SourceTermVectorReference", ",", "SourceTermVectorRight"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceTermVectorRight", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorReference", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorReference", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVectorReference", ",", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"Relaxation", "[", 
               RowBox[{"xs", "[", "i", "]"}], "]"}]], "*", 
             "SourceTermVectorRight"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "matrix"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixReference", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVectorReference", "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorReference", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVectorReference", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixReferenceExp", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVectorReference", "]"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.902646574535261*^9, 3.9026466059882126`*^9}, {
   3.9026467410699472`*^9, 3.9026467871686716`*^9}, {3.902647168018592*^9, 
   3.902647170311217*^9}, {3.9026508045443497`*^9, 3.9026508068546133`*^9}, {
   3.902650845322016*^9, 3.9026509033333035`*^9}, 3.902652559531111*^9, {
   3.9028237724048996`*^9, 3.9028237808430896`*^9}, {3.902824029388298*^9, 
   3.9028240530452194`*^9}, {3.902824100401947*^9, 3.902824106096154*^9}, {
   3.9028241624392776`*^9, 3.902824162576342*^9}, {3.902824657908075*^9, 
   3.902824658206683*^9}, {3.902825120821701*^9, 3.9028251599924726`*^9}, {
   3.9028251932100515`*^9, 3.9028251958718696`*^9}, {3.903861182769294*^9, 
   3.9038611835660996`*^9}, {3.904729523537224*^9, 3.904729595403613*^9}, 
   3.9047296776387362`*^9, {3.9047297606590443`*^9, 3.904729775986618*^9}, 
   3.9047298453748507`*^9, {3.904792379841877*^9, 3.904792411451561*^9}, {
   3.9312322479456716`*^9, 3.9312322680278845`*^9}, 3.9312325267530622`*^9, {
   3.932185423648675*^9, 3.932185426550521*^9}, {3.9322016065840225`*^9, 
