Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructMatrix", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "dx_", ",", 
     "momentsLeft_", ",", "momentsRight_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Define", " ", "the", " ", "model", " ", "matrices"}], " ", 
