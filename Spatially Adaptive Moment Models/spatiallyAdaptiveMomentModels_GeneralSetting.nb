Notebook[{

Cell[CellGroupData[{
Cell["\<\
Spatially Adaptive Finite Volume Method For Moment Models: General Setting\
\>", "Title",
 CellChangeTimes->{{3.898846352317824*^9, 3.8988463801127234`*^9}, {
  3.9325296840944014`*^9, 
  3.9325296912822523`*^9}},ExpressionUUID->"f4f860fd-6b1e-4e82-b442-\
62cb666614d2"],

Cell[TextData[StyleBox["This Mathematica file implements a spatially adaptive \
finite volume method for moment models. The spatial adaptivity allows the \
simulation to use a different number of moments (and so different models) in \
different parts of the domain. Currently, the setting is the following: the \
domain is divided in 2 subdomains. In the left subdomain, the number of \
moments (=: ML) is smaller than the number of moments (=: MR) in the right \
subdomain. \nIn this code, the interface between the two models is at the \
shock.\n----------------------------------------------------------------------\
----------------------\nTODO:\[LineSeparator]- Make source term matrices \
global variables\n- Dynamic plotting of the current time step\n- Dynamic \
plotting of the variables at the same time\n- Include multiple boundary \
interfaces",
 FontSize->36]], "Text",
 CellChangeTimes->{{3.898844431792612*^9, 3.8988445510433235`*^9}, {
  3.898845306130126*^9, 3.898845331313634*^9}, {3.902914628610138*^9, 
  3.9029146689989758`*^9}, {3.932203012973637*^9, 3.9322030754396353`*^9}, {
  3.9322097427285*^9, 3.9322097431712112`*^9}, {3.9322097798857307`*^9, 
  3.9322098096024914`*^9}},ExpressionUUID->"023a0f10-9db9-4b6d-8af1-\
bb301475341e"],

Cell[CellGroupData[{

Cell["Construction of Spatially Adaptive Moment Model", "Section",
 CellChangeTimes->{{3.8983311900025244`*^9, 3.8983312045160894`*^9}, {
  3.9026461987739944`*^9, 3.902646211242531*^9}, {3.902996923955519*^9, 
  3.902996924705532*^9}},ExpressionUUID->"7e4017df-6a07-49f3-a522-\
680746a0b1dc"],

Cell[TextData[StyleBox["Construction of the spatial discretization matrix of \
the models. The construction is split into transport part (Roe matrix and \
viscosity matrix) and source term part (relaxation).",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.9038541922672596`*^9, 3.9038542645392313`*^9}},
 FontSize->16,ExpressionUUID->"2dcbc35d-800c-4b59-a5e8-9ce8c25dcf78"],

