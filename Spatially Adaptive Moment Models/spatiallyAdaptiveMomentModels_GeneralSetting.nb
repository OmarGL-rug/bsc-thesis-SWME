Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ComputeInterfaceCellsLocations", "[", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "previousLocation", ",", "domainBoundaryLeft", ",", 
       "domainBoundaryRight"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"previousLocation", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"previousLocation", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"DiscretizedDomainDecomposition", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}], "*", 
           RowBox[{"MomentsDomainDecomposition", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "+", "1"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"interfaceCellsLocations", "=", 
       RowBox[{"List", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"domainBoundaryRight", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"m", "=", "1"}], ",", 
        RowBox[{"m", "<", 
         RowBox[{"Length", "[", "MomentsDomainDecomposition", "]"}]}], ",", 
        RowBox[{"m", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"domainBoundaryLeft", "=", "domainBoundaryRight"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MomentsDomainDecomposition", "[", 
             RowBox[{"[", 
              RowBox[{"m", "+", "1"}], "]"}], "]"}], ">", 
            RowBox[{"MomentsDomainDecomposition", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}], ",", 
           RowBox[{"domainBoundaryRight", "=", 
            RowBox[{
             RowBox[{"DiscretizedDomainDecomposition", "[", 
              RowBox[{"[", "m", "]"}], "]"}], "-", "1"}]}], ",", 
           RowBox[{"domainBoundaryRight", "=", 
            RowBox[{
             RowBox[{"DiscretizedDomainDecomposition", "[", 
              RowBox[{"[", "m", "]"}], "]"}], "+", "3"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"previousLocation", "=", 
          RowBox[{"previousLocation", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"domainBoundaryRight", "-", "domainBoundaryLeft"}], 
             ")"}], "*", 
            RowBox[{"MomentsDomainDecomposition", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"interfaceCellsLocations", ",", "previousLocation"}], "]"}],
          ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
