Cell[CellGroupData[{

Cell["Set up model", "Subsection",
 CellChangeTimes->{{3.9028177926869583`*^9, 3.9028178066772966`*^9}, {
  3.9038676760882425`*^9, 3.903867677865839*^9}, {3.9312307661456575`*^9, 
  3.9312307671423626`*^9}},ExpressionUUID->"b08e35a1-04bd-4b97-96c8-\
62fdebe7c3a8"],

Cell["\<\
Set spatial discretization parameters and call the spatial discretization \
matrix construction functions.\
\>", "Text",
 CellChangeTimes->{{3.9038627462816133`*^9, 3.9038627732352576`*^9}, 
   3.9038631491611505`*^9},
 FontSize->16,ExpressionUUID->"f8e19d5d-0717-41f3-a8b3-bb5f89e65f3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InitializeModel", "[", 
     RowBox[{
     "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
      "momentsRight_"}], "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"numberOfMomentsDifference", "=", 
        RowBox[{"momentsRight", "-", "momentsLeft"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"nxL", "+", "nxR"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"positionInFrontOfShock", "=", "0"}], ";"}], "*)"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "positionInFrontOfShock", " ", "is", " ", "not", " ", "used", " ", 
         "anymore"}], " ", "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"dx", "=", 
        FractionBox[
         RowBox[{"x2", "-", "x1"}], 
         RowBox[{"nxL", "+", "nxR"}]]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"InitializeVector", "[", 
        RowBox[{
        "momentsLeft", ",", "momentsRight", ",", "\"\<neighbour\>\""}], "]"}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Initialize", " ", "the", " ", "collection", " ", "of", " ", "the", 
         " ", "moments"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"moments", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsReference", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentReference", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsLowOrder", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentLowOrder", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"momentsLoop", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"moment", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"momentReference", "[", "i", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"momentLowOrder", "[", "i", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Initialize", " ", "the", " ", "sum", " ", "of", " ", "the", " ", 
        "moments", " ", "to", " ", "check", " ", "conservation"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"momentsSum", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"momentSum", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"momentsReferenceSum", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"momentReferenceSum", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"momentsLowOrderSum", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"momentLowOrderSum", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"momentSum", "[", "i", "]"}], "=", "0"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"momentReferenceSum", "[", "i", "]"}], "=", "0"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"momentLowOrderSum", "[", "i", "]"}], "=", "0"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Choose", " ", "time", " ", "step"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dt", "=", 
       RowBox[{"0.25", 
        FractionBox["dx", "CMax"]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"ConstructMatrix", "[", 
       RowBox[{
       "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", "momentsLeft",
         ",", "momentsRight", ",", "dt"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ConstructMatrixReference", "[", 
       RowBox[{
       "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", "momentsLeft",
         ",", "momentsRight", ",", "dt"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ConstructMatrixLowOrder", "[", 
       RowBox[{
       "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", "momentsLeft",
         ",", "dt"}], "]"}], ";"}], "\[IndentingNewLine]", ")"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
