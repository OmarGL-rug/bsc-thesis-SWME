Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Grid", " ", "information"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"-", "4"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x2", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Domain", " ", "decomposition", " ", "info"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"domainDecompositionList", "=", 
     RowBox[{"List", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "List", " ", "of", " ", "the", " ", "physical", " ", "positions", " ", 
     "where", " ", "thwo", " ", "models", " ", "with", " ", "different", " ", 
     "order", " ", "are", " ", "coupled"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MomentsDomainDecomposition", "=", 
     RowBox[{"List", "[", 
      RowBox[{"3", ",", "4", ",", "6"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Number", " ", "of", " ", "moments", " ", "in", " ", "each", " ", "part", 
     " ", "of", " ", "the", " ", "domain"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paddingCondition", "=", "\"\<neighbour\>\""}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Padding", " ", "condition", " ", "for", " ", "the", " ", "boundary", " ",
      "interface", " ", "coupling"}], " ", "*)"}], "\[IndentingNewLine]", 
