Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeLowOrder", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WLowOrder", "=", "WrawLowOrder"}], ";", "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeLowOrder", ",", "outputLowOrder"}], "}"}], "=", 
       "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
            "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
            "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"WLowOrder", "=", 
            RowBox[{"WLowOrder", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixLowOrder", ".", "WLowOrder"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"WLowOrder", "=", 
            RowBox[{"SourceTermMatrixLowOrderExp", ".", "WLowOrder"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsLeft"}], "]"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                  RowBox[{"momentsLeft", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"WLowOrder", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                  RowBox[{"momentsLeft", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "collection", " ", "of", " ", "each", " ", 
             "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"n", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"j", "=", "0"}], ",", 
                RowBox[{"j", "<", "momentsLeft"}], ",", 
                RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{
                    RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                    RowBox[{"WLowOrder", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLowOrder", "[", "i", "]"}], "=", " ", 
               RowBox[{"momentLoop", "[", "i", "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLowOrderSum", "[", "i", "]"}], "=", 
               RowBox[{"Total", "[", 
                RowBox[{"momentLowOrder", "[", "i", "]"}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
               RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", 
             " ", 
             RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
             RowBox[{"f2", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"\[Sqrt]", "2"}]], 
               RowBox[{"(", 
                RowBox[{"\[Rho]T", "+", 
                 SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"densityLowOrder", "=", 
            RowBox[{"momentLowOrder", "[", "0", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"velocityLowOrder", "=", 
            FractionBox[
             RowBox[{"momentLowOrder", "[", "1", "]"}], "densityLowOrder"]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"temperatureLowOrder", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"\[Sqrt]", "2"}], "*", 
               RowBox[{"momentLowOrder", "[", "2", "]"}]}], "-", 
              RowBox[{
              "densityLowOrder", "*", "velocityLowOrder", "*", 
               "velocityLowOrder"}], "+", "densityLowOrder"}], 
             "densityLowOrder"]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"time", " ", "=", " ", 
            RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 InitializationCell->True,
