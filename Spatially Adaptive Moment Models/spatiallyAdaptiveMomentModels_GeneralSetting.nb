Cell["\<\
Set spatial discretization parameters and call the spatial discretization \
matrix construction functions.\
\>", "Text",
 CellChangeTimes->{{3.9038627462816133`*^9, 3.9038627732352576`*^9}, 
   3.9038631491611505`*^9},
 FontSize->16,ExpressionUUID->"a3e1beab-8dec-46cd-b09f-401bc8a4bb3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InitializeModel", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "momentsLoop", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"DomainDecomposition", "[", "domainDecompositionList", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"dx", "=", 
         FractionBox[
          RowBox[{"x2", "-", "x1"}], "n"]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"MinMoment", "=", 
         RowBox[{"Min", "[", "MomentsDomainDecomposition", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"MaxMoment", "=", 
         RowBox[{"Max", "[", "MomentsDomainDecomposition", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"InitializeVector", "[", "\"\<neighbour\>\"", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Initialize", " ", "the", " ", "collection", " ", "of", " ", "the", 
          " ", "moments"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"moments", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"moment", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"MaxMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"momentsReference", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"momentReference", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"MaxMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"momentsLowOrder", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"momentLowOrder", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"MinMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsLoop", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"MaxMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "MaxMoment"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"moment", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"momentReference", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "MinMoment"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"momentLowOrder", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Initialize", " ", "the", " ", "sum", " ", "of", " ", "the", " ", 
         "moments", " ", "to", " ", "check", " ", "conservation"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"momentsSum", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentSum", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"MaxMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsReferenceSum", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentReferenceSum", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"MaxMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsLowOrderSum", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentLowOrderSum", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"MinMoment", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "MaxMoment"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"momentSum", "[", "i", "]"}], "=", "0"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"momentReferenceSum", "[", "i", "]"}], "=", "0"}], ";"}]}],
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "MinMoment"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"momentLowOrderSum", "[", "i", "]"}], "=", "0"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrix", "[", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrixReference", "[", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrixLowOrder", "[", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
