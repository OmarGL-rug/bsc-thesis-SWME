Cell[CellGroupData[{

Cell["Source Term", "Subsection",
 CellChangeTimes->{{3.9026464043234673`*^9, 
  3.9026464070493793`*^9}},ExpressionUUID->"a39185b2-5ddb-4e5c-9923-\
637e9b1f560f"],

Cell["\<\
Construction of the source term matrix for the reference system.\
\>", "Text",
 CellChangeTimes->{{3.9038607733774614`*^9, 3.903860781079492*^9}},
 FontSize->16,ExpressionUUID->"535cbf22-1bcd-41f9-9fb6-b0ffcbfe5d14"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTermLowOrder", "[", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"SourceTermVectorLowOrder", ",", "SourceTermVectorLeft"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "the", " ", "RHS", " ", "source", " ", "term"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "assume", " ", "a", " ", "BGK"}], "-", 
        RowBox[{
        "type", " ", "operator", " ", "and", " ", "we", " ", "assume", " ", 
         "that", " ", "the", " ", "source", " ", "term", " ", "matrix", " ", 
         "is", " ", "a", " ", "diagonal", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceTermVectorLeft", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "MinMoment"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorLeft", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorLeft", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorLowOrder", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorLowOrder", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVectorLowOrder", ",", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"Relaxation", "[", 
                RowBox[{"xs", "[", "i", "]"}], "]"}]]}], "*", 
             "SourceTermVectorLeft"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "matrix"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixLowOrder", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVectorLowOrder", "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorLowOrder", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVectorLowOrder", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixLowOrderExp", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVectorLowOrder", "]"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.902646574535261*^9, 3.9026466059882126`*^9}, {
   3.9026467410699472`*^9, 3.9026467871686716`*^9}, {3.902647168018592*^9, 
   3.902647170311217*^9}, {3.9026508045443497`*^9, 3.9026508068546133`*^9}, {
