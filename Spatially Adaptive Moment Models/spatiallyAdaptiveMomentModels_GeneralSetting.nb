4cb78d24e028"],

Cell["\<\
Definition of the time stepping methods. Forward Euler with a splitting \
between transport and relaxation is implemented for the different models. \
\>", "Text",
 CellChangeTimes->{{3.9038678257446566`*^9, 3.9038678811167073`*^9}, {
  3.903868585840213*^9, 3.9038685999557652`*^9}, {3.9217298933730745`*^9, 
  3.921729911141098*^9}},
 FontSize->18,ExpressionUUID->"8301803b-f0c0-4507-9dc9-c362ea828b21"],

Cell[CellGroupData[{

Cell["\<\
Spatially Adaptive Moment Model Using Padded Vector and Modified Roe \
Linearization At Boundary Interface\
\>", "Subsection",
 CellChangeTimes->{{3.902982457587117*^9, 3.9029824884969535`*^9}, {
  3.921729933522324*^9, 3.9217299410518093`*^9}, {3.928508770254043*^9, 
  3.928508787536889*^9}},ExpressionUUID->"56317c07-b87f-456c-89cf-\
24fe3599d741"],

Cell["\<\
Using the extended vector model combined with a modified Roe linearization in \
the equation for the cell right of the interface between the two models.\
\>", "Text",
 CellChangeTimes->{{3.9038679841453485`*^9, 3.90386800771356*^9}, {
  3.903868647497217*^9, 3.903868650396587*^9}, {3.9322020869627175`*^9, 
  3.9322021066718893`*^9}},
 FontSize->16,ExpressionUUID->"bbacdde6-fa4c-4fb9-81a8-ae305b47fe14"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeModifiedRoe", "[", "tend_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
     RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"timeSpatiallyAdaptiveModifiedRoe", ",", "outputModifiedRoe"}],
        "}"}], "=", "\[IndentingNewLine]", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
           "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
           "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"W", "=", 
           RowBox[{"W", "+", 
            RowBox[{"dt", "*", 
             RowBox[{"BigAMatrixModified", ".", "W"}]}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"W", "=", 
           RowBox[{"SourceTermMatrixExp", ".", "W"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsLeft"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
