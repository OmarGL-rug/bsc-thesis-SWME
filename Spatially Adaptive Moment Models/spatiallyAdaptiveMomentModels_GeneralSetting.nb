Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemePadded", "[", "tend_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
     RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"ComputeInterfaceCellsLocations", "[", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "timeSpatiallyAdaptivePadded", ",", "outputSpatiallyAdaptivePadded"}], 
       "}"}], "=", "\[IndentingNewLine]", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", "*)"}],
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", 
             RowBox[{"MomentsDomainDecomposition", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1", "+", 
                 RowBox[{"MomentsDomainDecomposition", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], ";"}]}], 
           " ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "left", " ", "boundary", " ", "condition"}], " ", 
            "*)"}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"k", "=", "1"}], ",", 
            RowBox[{"k", "<=", 
             RowBox[{"Length", "[", "interfaceCellsLocations", "]"}]}], ",", 
            RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"MomentsDomainDecomposition", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "+", "1"}], "]"}], "]"}], ">", 
                RowBox[{"MomentsDomainDecomposition", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"For", "[", 
                  RowBox[{
                   RowBox[{"i", "=", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", 
                   RowBox[{"i", "<", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}], ",", 
                   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"W", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"interfaceCellsLocations", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "+", "i"}], "]"}], "]"}], 
                    "=", 
                    RowBox[{"W", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"interfaceCellsLocations", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "+", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], "+", "i"}], "]"}], 
                    "]"}]}], ";"}]}], " ", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "Boundary", " ", "interface", " ", "boundary", " ", 
                    "condition", " ", "for", " ", "the", " ", "padded", " ", 
                    "moments"}], " ", "*)"}], "\[IndentingNewLine]", "]"}], 
                 ";"}], "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"For", "[", 
                  RowBox[{
                   RowBox[{"i", "=", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}]}], ",", 
                   RowBox[{"i", "<", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", 
                   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"W", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"interfaceCellsLocations", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "-", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "+", "i"}], "]"}], "]"}], 
                    "=", 
                    RowBox[{"W", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"interfaceCellsLocations", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "-", 
                    RowBox[{"2", "*", 
                    RowBox[{"MomentsDomainDecomposition", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "+", "i"}], "]"}], 
                    "]"}]}], ";"}]}], " ", 
                  RowBox[{"(*", " ", 
                   RowBox[{
                   "Boundary", " ", "interface", " ", "boundary", " ", 
                    "condition", " ", "for", " ", "the", " ", "padded", " ", 
                    "moments"}], " ", "*)"}], "\[IndentingNewLine]", "]"}], 
                 ";"}], "}"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", 
             RowBox[{"MomentsDomainDecomposition", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"Length", "[", "Wraw", "]"}], "-", 
