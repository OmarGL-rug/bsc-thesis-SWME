                    RowBox[{"nxL", "+", "1"}], ")"}]}], "+", 
                    RowBox[{"momentsRight", "*", 
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}]}], "+", "j", "+", "1"}], 
