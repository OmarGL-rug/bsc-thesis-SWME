Cell[CellGroupData[{

Cell["\<\
Comparison between reference solution and spatially adaptive moment models \
(work in progress)\
\>", "Subsection",
 CellChangeTimes->{{3.902811143319135*^9, 3.9028111587651825`*^9}, {
   3.902811267421636*^9, 3.902811275738428*^9}, {3.9028113872476635`*^9, 
   3.9028113912926393`*^9}, {3.9028114452871933`*^9, 3.902811449282693*^9}, 
   3.9041912428899527`*^9, {3.932202610112784*^9, 
   3.9322026145455027`*^9}},ExpressionUUID->"5b7e98df-9fd0-420e-af18-\
bd46e8fdf777"],

Cell["\<\
Simultaneous simulation of spatially adaptive moment model and reference \
solution\
\>", "Text",
 CellChangeTimes->{{3.9040508658688874`*^9, 3.904050869235757*^9}, {
  3.904050920795635*^9, 3.9040509332267895`*^9}, {3.904051086184588*^9, 
  3.9040510922471185`*^9}},
 FontSize->16,ExpressionUUID->"2598a85a-aa9b-422b-8d89-9fc6fa0125b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeComparison", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "norm", ",", "normRemainder", ",", "WeightedSumRoe", ",", 
       "WeightedSumViscosity", ",", "modelDiffA", ",", "modelDiffQ"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WReference", "=", "WrawReference"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeSpatiallyAdaptive", ",", "outputSpatiallyAdaptive"}], 
        "}"}], "=", "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"W", "=", 
            RowBox[{"W", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrix", ".", "W"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"WReference", "=", 
            RowBox[{"WReference", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixReference", ".", "WReference"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"W", "=", 
            RowBox[{"SourceTermMatrix", ".", "W"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"WReference", "=", 
            RowBox[{"SourceTermMatrixReference", ".", "WReference"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsLeft"}], "]"}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsRight"}], "]"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "collection", " ", "of", " ", "each", " ", 
             "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentReferenceLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "nxL"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"j", "=", "0"}], ",", 
               RowBox[{"j", "<", "momentsLeft"}], ",", 
               RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                RowBox[{"Append", "[", 
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                  RowBox[{"W", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"nxR", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"j", "=", "0"}], ",", 
               RowBox[{"j", "<", "momentsRight"}], ",", 
               RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                RowBox[{"Append", "[", 
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                  RowBox[{"W", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                    RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"n", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"j", "=", "0"}], ",", 
                RowBox[{"j", "<", "momentsRight"}], ",", 
                RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"momentReferenceLoop", "[", "j", "]"}], "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{
                    RowBox[{"momentReferenceLoop", "[", "j", "]"}], ",", 
                    RowBox[{"WReference", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"moment", "[", "i", "]"}], "=", 
               RowBox[{"momentLoop", "[", "i", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentReference", "[", "i", "]"}], "=", " ", 
               RowBox[{"momentReferenceLoop", "[", "i", "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
               RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", 
             " ", 
             RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
             RowBox[{"f2", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"\[Sqrt]", "2"}]], 
               RowBox[{"(", 
                RowBox[{"\[Rho]T", "+", 
                 SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"density", "=", 
            RowBox[{"moment", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"velocity", "=", 
            FractionBox[
             RowBox[{"moment", "[", "1", "]"}], "density"]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"temperature", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"\[Sqrt]", "2"}], "*", 
               RowBox[{"moment", "[", "2", "]"}]}], "-", 
              RowBox[{"density", "*", "velocity", "*", "velocity"}], "+", 
              "density"}], "density"]}], ";", "\[IndentingNewLine]", 
           RowBox[{"densityReference", "=", 
            RowBox[{"momentReference", "[", "0", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"velocityReference", "=", 
            FractionBox[
             RowBox[{"momentReference", "[", "1", "]"}], 
             "densityReference"]}], ";", "\[IndentingNewLine]", 
           RowBox[{"temperatureReference", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"\[Sqrt]", "2"}], "*", 
               RowBox[{"momentReference", "[", "2", "]"}]}], "-", 
              RowBox[{
              "densityReference", "*", "velocityReference", "*", 
               "velocityReference"}], "+", "densityReference"}], 
             "densityReference"]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"time", " ", "=", " ", 
            RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9028116810267124`*^9, 3.9028117029875937`*^9}, {
  3.9028117910971093`*^9, 3.902811836003031*^9}, {3.902811879320593*^9, 
  3.902811905853942*^9}, {3.902812004892338*^9, 3.9028120337520723`*^9}, {
  3.9028122302598114`*^9, 3.902812231123058*^9}, {3.9028146823937593`*^9, 
