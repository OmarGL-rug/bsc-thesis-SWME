9a56241c61da"],

Cell["\<\
Construct vector with the chosen initial values, for the models using the \
extended vector.\
\>", "Text",
 CellChangeTimes->{{3.9038623148569927`*^9, 3.9038623329932117`*^9}, {
  3.916482943524144*^9, 3.916482950003914*^9}},
 FontSize->16,ExpressionUUID->"7dcfe13f-7f45-49a9-bb3f-d1451b5b041e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitializeVector", "[", "paddingCondition_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "padding", ",", "nxL", ",", "nxR", ",", "momentsLeft", ",", 
       "momentsRight"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "initial", " ", "vector", " ", "for", " ", 
       "spatially", " ", "adaptive", " ", "simulation"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Wraw", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "0"}], ",", 
        RowBox[{"j", "<", 
         RowBox[{"MomentsDomainDecomposition", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Wraw", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"Wraw", ",", 
            RowBox[{"m0", "[", 
             RowBox[{"j", ",", 
              RowBox[{"xs", "[", "1", "]"}]}], "]"}]}], "]"}]}], ";"}]}], 
       RowBox[{"(*", " ", 
        RowBox[{
        "Zero", " ", "order", " ", "extrapolation", " ", "for", " ", "ghost", 
         " ", "cell"}], " ", "*)"}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nxR", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
