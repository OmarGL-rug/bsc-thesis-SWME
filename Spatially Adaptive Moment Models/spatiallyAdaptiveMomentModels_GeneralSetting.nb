                  RowBox[{"(", 
                   RowBox[{"nxR", "+", "2"}], ")"}]}], "+", "i", "+", "1"}], 
                "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", 
                  RowBox[{"(", 
                   RowBox[{"nxL", "-", "1"}], ")"}]}], "+", 
                 RowBox[{"momentsRight", "*", 
                  RowBox[{"(", 
                   RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                "]"}], "]"}]}], ";"}]}], " ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "right", " ", "boundary", " ", "condition"}], " ", 
            "*)"}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Update", " ", "collection", " ", "of", " ", "each", " ", 
            "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"momentLoop", "[", "i", "]"}], "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "nxL"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "0"}], ",", 
              RowBox[{"j", "<", "momentsLeft"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentLoop", "[", "j", "]"}], "=", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                 RowBox[{"W", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], 
                   "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<=", 
             RowBox[{"nxR", "+", "1"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "0"}], ",", 
