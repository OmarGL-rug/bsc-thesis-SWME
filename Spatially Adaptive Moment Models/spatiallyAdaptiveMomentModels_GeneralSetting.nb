Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"InitializeModelNonSquare", "[", 
      RowBox[{
      "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
       "momentsRight_"}], "]"}], ":=", 
     RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"numberOfMomentsDifference", "=", 
        RowBox[{"momentsRight", "-", "momentsLeft"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"nxL", "+", "nxR"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"dx", "=", 
        FractionBox[
         RowBox[{"x2", "-", "x1"}], 
         RowBox[{"nxL", "+", "nxR"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Create", " ", "grid", " ", "points"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xs", "[", "i_", "]"}], ":=", 
        RowBox[{"x1", "+", 
         RowBox[{"dx", "*", 
          RowBox[{"(", 
           RowBox[{"i", "-", "0.5"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", 
       RowBox[{"InitializeVectorNonSquare", "[", 
        RowBox[{"momentsLeft", ",", "momentsRight"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Initialize", " ", "the", " ", "collection", " ", "of", " ", "the", 
         " ", "moments"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"moments", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsReference", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentReference", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"momentsLoop", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "momentsRight"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"moment", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"momentReference", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Initialize", " ", "the", " ", "sum", " ", "of", " ", "the", " ", 
         "moments", " ", "to", " ", "check", " ", "conservation"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"momentsSum", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"momentSum", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "0"}], ",", 
         RowBox[{"i", "<", "momentsRight"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"momentSum", "[", "i", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Choose", " ", "time", " ", "step"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dt", "=", 
        RowBox[{"0.1", 
         FractionBox["dx", "CMax"]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrix", "[", 
        RowBox[{
        "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", 
         "momentsLeft", ",", "momentsRight", ",", "dt"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ConstructMatrixReference", "[", 
        RowBox[{
        "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", 
         "momentsLeft", ",", "momentsRight", ",", "dt"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ")"}]}], ";"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "THIS", " ", "METHOD", " ", "IS", " ", "NOT", " ", "USED", " ", 
    "ANYMORE"}], " ", "*)"}]}]], "Input",
 InitializationCell->True,
