            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
           RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
           RowBox[{"Sqrt", "[", "i", "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "the", " ", "RHS", " ", "source", " ", "term"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "assume", " ", "a", " ", "BGK"}], "-", 
