Cell[CellGroupData[{

Cell["\<\
Construction of model at the interface between the two subdomains\
\>", "Subsection",
 CellChangeTimes->{{3.903436918942368*^9, 
  3.9034369406005497`*^9}},ExpressionUUID->"a274cf04-937a-4c5a-a52f-\
c3df39fa4bed"],

Cell["\<\
There are different options for the model we use in the cell directly right \
of the interface between the left and the right subdomains, in which a \
different number of moments is used. \
\>", "Text",
 CellChangeTimes->{{3.9038550177270308`*^9, 3.9038551251558237`*^9}},
 FontSize->16,ExpressionUUID->"54a572d2-2065-43ab-a504-63827afdc960"],

Cell[CellGroupData[{

Cell["Using a modified system matrix at the boundary interface ", \
"Subsubsection",
 CellChangeTimes->{{3.9034371145258856`*^9, 3.903437128087574*^9}, {
   3.9217312835213366`*^9, 3.921731315544826*^9}, 3.9217313592016826`*^9, {
   3.9285063795612345`*^9, 
   3.9285063888491535`*^9}},ExpressionUUID->"b30aa5d1-085c-42fa-a727-\
9858887f40b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Here", " ", "we", " ", "use", " ", "a", " ", "modified", " ", "Roe", " ", 
    "linearization", " ", "at", " ", "the", " ", "boundary", " ", 
    "interface"}], " ", "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "THIS", " ", "METHOD", " ", "HAS", " ", "NOT", " ", "BEEN", " ", "TESTED", 
    " ", "YET"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"modifiedRoeMatrixAtInterface", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "momentsLeft", ",", "momentsRight", ",", "numberOfMomentsDifference", 
        ",", "ALeft", ",", "ARight", ",", "QLeft", ",", "QRight"}], "}"}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "<", 
          RowBox[{"Length", "[", "MomentsDomainDecomposition", "]"}]}], ",", 
         RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
