Cell["Source Term", "Subsection",
 CellChangeTimes->{{3.9026439467348037`*^9, 3.902643953751412*^9}, {
  3.9026453663618517`*^9, 3.902645369247607*^9}, {3.9026464090009727`*^9, 
  3.90264640931116*^9}},ExpressionUUID->"9fbc9ad6-7f9d-4940-887d-\
1f2dc4743291"],

Cell[TextData[StyleBox["Computation of source term.",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.9164780111337566`*^9, 3.9164780178645306`*^9}, {
  3.9200044622721977`*^9, 
  3.920004462364504*^9}},ExpressionUUID->"2a423a51-cfdb-4495-aa01-\
3bf433bac4fc"],

Cell[CellGroupData[{

Cell["Extended vector models", "Subsubsection",
 CellChangeTimes->{{3.916476854846704*^9, 
  3.9164768579459057`*^9}},ExpressionUUID->"6d054063-fe7b-4fa4-a7a2-\
7aab57d5f7e2"],

Cell["\<\
Construction of the source term matrix for the models using the extended \
vector.\
\>", "Text",
 CellChangeTimes->{{3.903854433884282*^9, 3.9038544491965017`*^9}, {
  3.916476834003949*^9, 3.91647684392305*^9}},
 FontSize->16,ExpressionUUID->"9b4f2dad-beb9-45d8-9add-118cc9af8c53"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTerm", "[", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "SourceTermVector", ",", "moments", ",", "SourceTermVectorCell", ",", 
       "nxL", ",", "nxR"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nxR", "=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"k", "<", 
         RowBox[{"Length", "[", "MomentsDomainDecomposition", "]"}]}], ",", 
        RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nxL", "=", 
          RowBox[{"nxR", "+", "1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MomentsDomainDecomposition", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], ">", 
            RowBox[{"MomentsDomainDecomposition", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ",", 
           RowBox[{"nxR", "=", 
            RowBox[{
             RowBox[{"DiscretizedDomainDecomposition", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "-", "2"}]}], ",", 
           RowBox[{"nxR", "=", 
            RowBox[{
             RowBox[{"DiscretizedDomainDecomposition", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "+", "2"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SourceTermVectorCell", "=", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"moments", "=", 
          RowBox[{"MomentsDomainDecomposition", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "4"}], ",", 
           RowBox[{"j", "<=", "moments"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceTermVectorCell", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"SourceTermVectorCell", ",", "1"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "nxL"}], ",", 
           RowBox[{"i", "<=", "nxR"}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceTermVector", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"SourceTermVector", ",", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["1", 
                  RowBox[{"Relaxation", "[", 
                   RowBox[{"xs", "[", "i", "]"}], "]"}]]}], "*", 
                "SourceTermVectorCell"}]}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"moments", "=", 
       RowBox[{"MomentsDomainDecomposition", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorCell", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "4"}], ",", 
        RowBox[{"j", "<=", "moments"}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorCell", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorCell", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"nxR", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"Relaxation", "[", 
                RowBox[{"xs", "[", "i", "]"}], "]"}]]}], "*", 
             "SourceTermVectorCell"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "matrix"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrix", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVector", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixExp", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9026443436550684`*^9, 3.902644349713498*^9}, {
   3.90264439035752*^9, 3.90264445232934*^9}, {3.9026447547300086`*^9, 
   3.9026448094880157`*^9}, {3.9026450398203893`*^9, 3.902645041707831*^9}, 
   3.9026468582274456`*^9, {3.902647155618944*^9, 3.9026471583085127`*^9}, {
   3.902650460498855*^9, 3.9026504791238303`*^9}, {3.902651071332897*^9, 
   3.9026510725840483`*^9}, {3.902823517069681*^9, 3.9028235261578703`*^9}, {
   3.902824060423334*^9, 3.9028240655638695`*^9}, {3.9028241564725556`*^9, 
   3.9028241567584553`*^9}, {3.902824565531398*^9, 3.9028245656674848`*^9}, {
   3.902824650298018*^9, 3.902824650695034*^9}, {3.9048077701105986`*^9, 
   3.9048077755876284`*^9}, {3.9048090132741804`*^9, 
   3.9048090436143413`*^9}, {3.9048092235244427`*^9, 3.904809224045024*^9}, {
   3.904809776633191*^9, 3.9048097856046557`*^9}, {3.90481120009394*^9, 
   3.904811202011631*^9}, {3.928467424720708*^9, 3.928467553969041*^9}, {
   3.9312312873653727`*^9, 3.9312313033142357`*^9}, {3.9312314515941873`*^9, 
   3.9312314597777624`*^9}, {3.9312315109823675`*^9, 3.9312315713182817`*^9}, 
   3.9312324655044813`*^9, {3.931236585142211*^9, 3.931236586531751*^9}, {
   3.932187128253154*^9, 3.9321871634059215`*^9}, {3.9321880733057747`*^9, 
   3.9321880923680887`*^9}, {3.9322011377594757`*^9, 3.932201164384019*^9}, {
   3.9322012521047134`*^9, 3.932201265634283*^9}, {3.932201573399789*^9, 
   3.932201586556136*^9}, 3.9322029931963253`*^9, {3.9322101129758377`*^9, 
   3.9322101250790315`*^9}, {3.936703583472359*^9, 3.9367035855600576`*^9}, {
   3.937535812307228*^9, 3.9375358834037075`*^9}, {3.937536110699644*^9, 
   3.9375362472329226`*^9}, {3.9375372138107853`*^9, 
   3.9375372184334936`*^9}, {3.9375372522286654`*^9, 
   3.9375373297516613`*^9}, {3.937537717587508*^9, 3.9375378230497265`*^9}, {
   3.937538232189371*^9, 3.937538341250702*^9}, 3.937625556365221*^9, {
   3.9379093463600388`*^9, 3.937909346646471*^9}, 3.9386574719316177`*^9, {
   3.938657560783079*^9, 3.9386576358604984`*^9}, {3.9386576837646074`*^9, 
   3.938657721756727*^9}, {3.9387471488593044`*^9, 3.9387471492352905`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"40e39bbe-a4d7-4c87-a555-6fdd7a06f891"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Non-square matrix models (THIS METHOD IS NOT USED ANYMORE)", \
"Subsubsection",
 CellChangeTimes->{{3.91647686679144*^9, 3.916476877499366*^9}, {
  3.937905558738529*^9, 
  3.9379055712725525`*^9}},ExpressionUUID->"ced14a8b-c38a-4b8b-9875-\
f3003e06cbde"],

Cell["\<\
Construction of the source term for the model that used non-square matrices.\
\>", "Text",
 CellChangeTimes->{{3.9164779827800264`*^9, 
  3.916477997909968*^9}},ExpressionUUID->"8519cca0-dfc4-4772-9cfa-\
00539eb31e6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTermNonSquare", "[", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "SourceMatrixLeft", ",", "SourceMatrixRight", ",", 
       "SourceTermVectorLeft", ",", "SourceTermVectorRight", ",", 
       "SourceTermVector"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "the", " ", "RHS", " ", "source", " ", "term"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "assume", " ", "a", " ", "BGK"}], "-", 
        RowBox[{
        "type", " ", "operator", " ", "and", " ", "we", " ", "assume", " ", 
         "that", " ", "the", " ", "source", " ", "term", " ", "matrix", " ", 
         "is", " ", "a", " ", "diagonal", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nxR", "=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"k", "<=", 
         RowBox[{"Length", "[", "MomentsDomainDecomposition", "]"}]}], ",", 
        RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nxL", "=", 
          RowBox[{"nxR", "+", "1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"nxR", "=", 
          RowBox[{"DiscretizedDomainDecomposition", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"SourceTermVectorCell", "=", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"moments", "=", 
          RowBox[{"MomentsDomainDecomposition", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "4"}], ",", 
           RowBox[{"j", "<=", "moments"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceTermVectorCell", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"SourceTermVectorCell", ",", "1"}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "nxL"}], ",", 
           RowBox[{"i", "<=", "nxR"}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceTermVector", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"SourceTermVector", ",", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["1", 
                  RowBox[{"Relaxation", "[", 
                   RowBox[{"xs", "[", "i", "]"}], "]"}]]}], "*", 
                "SourceTermVectorCell"}]}], "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"SourceTermVector", ",", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", 
            RowBox[{"Relaxation", "[", 
             RowBox[{"xs", "[", 
              RowBox[{"n", "-", "1"}], "]"}], "]"}]]}], "*", 
          "SourceTermVectorCell"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"SourceTermVector", ",", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", 
            RowBox[{"Relaxation", "[", 
             RowBox[{"xs", "[", "n", "]"}], "]"}]]}], "*", 
          "SourceTermVectorCell"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"SourceTermVector", ",", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", 
            RowBox[{"Relaxation", "[", 
             RowBox[{"xs", "[", 
              RowBox[{"n", "+", "1"}], "]"}], "]"}]]}], "*", 
          "SourceTermVectorCell"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "matrix"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixNonSquare", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVector", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixNonSquareExp", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9164770546297903`*^9, 3.916477056152053*^9}, {
   3.9164771312992697`*^9, 3.9164771314013367`*^9}, {3.916477172673423*^9, 
   3.9164771770102935`*^9}, {3.9164776096977286`*^9, 
   3.9164776175789237`*^9}, {3.9164778450660048`*^9, 
   3.9164778640476108`*^9}, {3.9164778979846582`*^9, 3.916477949176943*^9}, {
   3.9312318668001747`*^9, 3.9312319028270707`*^9}, 3.931232478726731*^9, {
   3.932186191078508*^9, 3.932186229612897*^9}, {3.932186330285102*^9, 
   3.9321863463208055`*^9}, {3.932186396385851*^9, 3.9321864360612397`*^9}, 
   3.9321864704336605`*^9, {3.9321865212819915`*^9, 3.9321865916053324`*^9}, {
   3.9322011923223343`*^9, 3.9322011992359366`*^9}, {3.932201276541548*^9, 
   3.932201326115985*^9}, {3.932201563491973*^9, 3.932201563899364*^9}, {
   3.932201628553589*^9, 3.9322016448396606`*^9}, {3.936782985876357*^9, 
   3.9367829879085293`*^9}, {3.937902782276865*^9, 3.937902799524639*^9}, {
   3.937902892417845*^9, 3.937902892569998*^9}, {3.9379029983021736`*^9, 
   3.93790301046949*^9}, {3.9379093513332214`*^9, 3.937909351618969*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"2551381d-e412-45e0-94af-6f1b7e476233"]
}, Closed]]
