Cell[BoxData[
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Compute", " ", "the", " ", "values", " ", "of", " ", "the", " ", "point",
      " ", "s0", " ", "along", " ", "the", " ", "path"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "momentsLeft"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"norm", "+=", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"momentsLeft", "*", "nxL"}], "+", "i"}], "]"}], "]"}], 
           "-", 
           RowBox[{"W", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
              "i"}], "]"}], "]"}]}], ")"}], "2"]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"normRemainder", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", 
       RowBox[{"momentsLeft", "+", "1"}]}], ",", 
      RowBox[{"i", "<=", "momentsRight"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"normRemainder", "+=", 
        SuperscriptBox[
         RowBox[{"W", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
            "i"}], "]"}], "]"}], "2"]}], ";"}]}], "\[IndentingNewLine]", 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
        RowBox[{"Sqrt", "[", "normRemainder", "]"}]}], "==", "0"}], ",", 
      RowBox[{"s0", "=", "0"}], ",", 
      RowBox[{"s0", "=", 
       FractionBox[
        RowBox[{"Sqrt", "[", "norm", "]"}], 
        RowBox[{
         RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
         RowBox[{"Sqrt", "[", "normRemainder", "]"}]}]]}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"s0", "=", "0"}], ";"}], " ", "*)"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "THE", " ", "SYSTEM", " ", "MATRIX", " ", "HERE", " ", "IS", " ", "A", 
      " ", "WEIGHTED", " ", "SUM", " ", "OF", " ", "THE", " ", "BIGGER", " ", 
      "MATRIX", " ", "AND", " ", "THE", " ", "SMALLER", " ", "MATRIX"}], " ", 
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"WeightedSumRoe", "=", 
     RowBox[{
      RowBox[{"s0", "*", "ATilde"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "s0"}], ")"}], "*", "ARight"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WeightedSumRoe", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
         RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"WeightedSumViscosity", "=", 
     RowBox[{
      RowBox[{"s0", "*", "QTilde"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "s0"}], ")"}], "*", "QRight"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WeightedSumViscosity", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
         RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"modelDiffA", "=", 
     RowBox[{"ATilde", "-", "ARight"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"modelDiffQ", "=", 
     RowBox[{"QTilde", "-", "QRight"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"modelDiffA", "[", 
      RowBox[{"[", 
