 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "0"}], ",", 
     RowBox[{"i", "<", "momentsRight"}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{
      RowBox[{"moment", "[", "i", "]"}], "=", 
