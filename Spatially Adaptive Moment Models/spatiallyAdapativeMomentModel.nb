Cell[CellGroupData[{

Cell["Construction of the spatial discretization matrix", "Section",
 CellChangeTimes->{{3.8983311900025244`*^9, 
  3.8983312045160894`*^9}},ExpressionUUID->"7a3cef64-10b1-4b4a-b62e-\
d0fd8d3670c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "model", " ", "matrices"}], " ", "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ALeft", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
           RowBox[{
            RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
          RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
           RowBox[{
            RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
          RowBox[{"Sqrt", "[", "i", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ARight", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
           RowBox[{
            RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
          RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
           RowBox[{
            RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
          RowBox[{"Sqrt", "[", "i", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ATilde", "=", "ARight"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ATilde", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "All"}], "]"}], "]"}], "=", "0"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "numerical", " ", "viscosity", " ", 
     "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QLeft", "=", 
     RowBox[{"IdentityMatrix", "[", "momentsLeft", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QRight", "=", 
     RowBox[{"IdentityMatrix", "[", "momentsRight", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QTilde", "=", "QRight"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"QTilde", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "All"}], "]"}], "]"}], "=", "0"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Roe", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "+", "2"}], ",", 
         RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Viscosity", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "+", "2"}], ",", 
         RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
     "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], " ",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "<=", "nxL"}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Roe", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Viscosity", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", 
      RowBox[{"nxL", "+", "1"}]}], ",", 
     RowBox[{"j", "<=", 
      RowBox[{"n", "+", "2"}]}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Roe", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsRight"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Viscosity", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsRight"}], "}"}]}], "]"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Rows", " ", "corresponding", " ", "to", " ", "moment", " ", "model", " ",
      "of", " ", "order", " ", "ML"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "2"}], ",", 
      RowBox[{"i", "<", "nxL"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Roe", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", 
           RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", "ALeft"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Roe", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Roe", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", 
           RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "ALeft"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Viscosity", "[", 
