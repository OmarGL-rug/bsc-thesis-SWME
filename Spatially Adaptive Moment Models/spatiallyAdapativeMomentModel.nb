Cell[BoxData[{
 RowBox[{
  RowBox[{"moments", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"moment", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], 
