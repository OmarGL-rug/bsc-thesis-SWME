5474bac6d767"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "computes", " ", "the", " ", "eigenvalues", " ", "of", " ", 
    "the", " ", "spatial", " ", "discretization", " ", "matrix"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eigenvaluesStabilityMatrix", "=", 
     RowBox[{"Eigenvalues", "[", "StabilityMatrix", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"realPartEigenvalues", "=", 
     RowBox[{"Re", "[", "eigenvaluesStabilityMatrix", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"realPartEigenvaluesSorted", "=", 
     RowBox[{"Sort", "[", "realPartEigenvalues", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.901428159156717*^9, 3.90142816701915*^9}, {
