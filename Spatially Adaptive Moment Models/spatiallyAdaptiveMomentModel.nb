         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{
          RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
