       RowBox[{"normRemainder", "+=", 
        SuperscriptBox[
         RowBox[{"W", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
            "i"}], "]"}], "]"}], "2"]}], ";"}]}], "\[IndentingNewLine]", 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
        RowBox[{"Sqrt", "[", "normRemainder", "]"}]}], "==", "0"}], ",", 
      RowBox[{"s0", "=", "0"}], ",", 
