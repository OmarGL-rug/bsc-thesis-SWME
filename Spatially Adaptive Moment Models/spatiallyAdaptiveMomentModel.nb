Cell["\<\
Definition of the time stepping methods. Forward Euler with a splitting \
between transport and relaxation is implemented for the different models. \
\>", "Text",
 CellChangeTimes->{{3.9038678257446566`*^9, 3.9038678811167073`*^9}, {
  3.903868585840213*^9, 3.9038685999557652`*^9}},
 FontSize->18,ExpressionUUID->"83bc2896-5c04-4703-85b4-3c71951e94f5"],

Cell[CellGroupData[{

Cell["Spatially Adaptive Moment Model With Weighted Sum", "Subsection",
 CellChangeTimes->{{3.9026535503617134`*^9, 3.902653555075504*^9}, {
  3.9029824347321787`*^9, 
  3.902982444757786*^9}},ExpressionUUID->"214c0758-cd4d-4ef4-8e1d-\
b6748dbec98d"],

Cell["\<\
Using a weighted sum in the equation for the cell right of the interface \
between the two models.\
\>", "Text",
 CellChangeTimes->{{3.9038679146806583`*^9, 3.9038679457055483`*^9}, 
   3.903868604862116*^9},
 FontSize->16,ExpressionUUID->"2f3a0e24-1a0e-45c4-92ba-d1078ddbdf77"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeS0", "[", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"norm", ",", "normRemainder"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Compute", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
      "point", " ", "s0", " ", "along", " ", "the", " ", "path"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "momentsLeft"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"norm", "+=", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"W", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"momentsLeft", "*", "nxL"}], "+", "i"}], "]"}], "]"}], 
            "-", 
            RowBox[{"W", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
               "i"}], "]"}], "]"}]}], ")"}], "2"]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"normRemainder", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"momentsLeft", "+", "1"}]}], ",", 
       RowBox[{"i", "<=", "momentsRight"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"normRemainder", "+=", 
         SuperscriptBox[
          RowBox[{"W", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
             "i"}], "]"}], "]"}], "2"]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
         RowBox[{"Sqrt", "[", "normRemainder", "]"}]}], "==", "0"}], ",", 
       RowBox[{"s0", "=", "0"}], ",", 
       RowBox[{"s0", "=", 
        FractionBox[
         RowBox[{"Sqrt", "[", "norm", "]"}], 
         RowBox[{
          RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
          RowBox[{"Sqrt", "[", "normRemainder", "]"}]}]]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "s0", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.904192288790542*^9, 3.904192305031928*^9}, {
  3.9041925485315423`*^9, 3.904192553023797*^9}, {3.904193092739098*^9, 
  3.9041931400801706`*^9}, {3.904194545869429*^9, 3.904194549635558*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"1cae3156-2459-4475-8ea9-2163c4c370b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConstructWeightedSum", "[", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "norm", ",", "normRemainder", ",", "WeightedSumRoe", ",", 
      "WeightedSumViscosity", ",", "modelDiffA", ",", "modelDiffQ", ",", 
      "AWeightedSumLastColumns", ",", "QWeightedSumLastColumns"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Compute", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
      "point", " ", "s0", " ", "along", " ", "the", " ", "path"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s0", "=", 
      RowBox[{"ComputeS0", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "momentsLeft"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"norm", "+=", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", "nxL"}], "+", "i"}], "]"}], 
               "]"}], "-", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", 
                 "+", "i"}], "]"}], "]"}]}], ")"}], "2"]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"normRemainder", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", 
          RowBox[{"momentsLeft", "+", "1"}]}], ",", 
         RowBox[{"i", "<=", "momentsRight"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"normRemainder", "+=", 
           SuperscriptBox[
            RowBox[{"W", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
               "i"}], "]"}], "]"}], "2"]}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
           RowBox[{"Sqrt", "[", "normRemainder", "]"}]}], "==", "0"}], ",", 
         RowBox[{"s0", "=", "0"}], ",", 
         RowBox[{"s0", "=", 
          FractionBox[
           RowBox[{"Sqrt", "[", "norm", "]"}], 
           RowBox[{
            RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
            RowBox[{"Sqrt", "[", "normRemainder", "]"}]}]]}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "THE", " ", "SYSTEM", " ", "MATRIX", " ", "HERE", " ", "IS", " ", "A", 
       " ", "WEIGHTED", " ", "SUM", " ", "OF", " ", "THE", " ", "BIGGER", " ",
        "MATRIX", " ", "AND", " ", "THE", " ", "SMALLER", " ", "MATRIX"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"WeightedSumRoe", "=", 
      RowBox[{
       RowBox[{"s0", "*", "ATilde"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "s0"}], ")"}], "*", "ARight"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"WeightedSumViscosity", "=", 
      RowBox[{
       RowBox[{"s0", "*", "QTilde"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "s0"}], ")"}], "*", "QRight"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"modelDiffA", "=", 
      RowBox[{"ATilde", "-", "ARight"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"modelDiffQ", "=", 
      RowBox[{"QTilde", "-", "QRight"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"AWeightedSumLastColumns", "=", "WeightedSumRoe"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"QWeightedSumLastColumns", "=", "WeightedSumViscosity"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"AWeightedSumLastColumns", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"QWeightedSumLastColumns", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WeightedSumRoe", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{
          RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
          RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WeightedSumViscosity", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{
          RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
          RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"BigAMatrixWeightedSumFlatten", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
           "1"}], ";;", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"momentsRight", "*", "2"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", "1"}], ";;", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight"}]}]}], 
        "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"2", "*", "dx"}]]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "WeightedSumRoe"}], "-", "WeightedSumViscosity"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"BigAMatrixWeightedSumFlatten", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
           "1"}], ";;", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"momentsRight", "*", "2"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
           "1"}], ";;", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"momentsRight", "*", "2"}]}]}]}], "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"2", "*", "dx"}]]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s0", "*", "modelDiffA"}], "-", "AWeightedSumLastColumns", 
         "+", 
         RowBox[{"2", "*", "QRight"}], "+", 
         RowBox[{"s0", "*", "modelDiffQ"}], "-", "QWeightedSumLastColumns"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"BigAMatrixWeightedSumFlatten", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", "+", 
           "1"}], ";;", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"momentsRight", "*", "2"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"2", "*", "momentsRight"}], "+", "1"}], ";;", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"momentsRight", "*", "3"}]}]}]}], "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"2", "*", "dx"}]]}], "*", 
       RowBox[{"(", 
        RowBox[{"ARight", "-", "QRight"}], ")"}]}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.904191283626763*^9, 3.9041912868113565`*^9}, {
   3.904191759053214*^9, 3.9041917591770573`*^9}, {3.9041919183787975`*^9, 
