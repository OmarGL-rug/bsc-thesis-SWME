                RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"BigAMatrix", "[", 
