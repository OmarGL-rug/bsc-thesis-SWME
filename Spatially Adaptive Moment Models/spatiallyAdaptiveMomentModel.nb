Cell[CellGroupData[{

Cell["Stability analysis", "Section",
 CellChangeTimes->{{3.901023099416278*^9, 
  3.901023105143532*^9}},ExpressionUUID->"7351efa1-0456-4fdc-8879-\
fbb470eb5aa1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StabilityMatrix", " ", "=", " ", 
    RowBox[{"BigAMatrixFlatten", "+", "SourceTermMatrix"}]}], ";"}], 
