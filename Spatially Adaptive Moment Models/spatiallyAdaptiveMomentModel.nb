420485f50a01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Hee", " ", "we", " ", "use", " ", "the", " ", "bigger", " ", "model", 
     " ", "in", " ", "the", " ", "cells", " ", "at", " ", "the", " ", 
     "interface", " ", "and", " ", "apply", " ", "a", " ", "correction", " ", 
     "for", " ", "not", " ", "having", " ", "a", " ", "non"}], "-", 
    RowBox[{
    "zero", " ", "value", " ", "for", " ", "the", " ", "last", " ", "moment", 
     " ", "in", " ", "the", " ", "cell", " ", "left", " ", "of", " ", "the", 
     " ", "interface"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BiggerModelAtInterface", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ARightLastColumns", "=", "ARight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"QRightLastColumns", "=", "QRight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ARightLastColumns", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"QRightLastColumns", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RoeBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "ARight"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"RoeBiggerModel", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nxL", "+", "2"}], ",", 
            RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{
            RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
            RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RoeBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "ARightLastColumns"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RoeBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", "ARight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ViscosityBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"ViscosityBiggerModel", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nxL", "+", "2"}], ",", 
            RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{
            RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
            RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ViscosityBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"2", "*", "QRight"}], "-", "QRightLastColumns"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ViscosityBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "QRight"}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9034372664654865`*^9, 3.9034372913474274`*^9}, {
  3.9034373947555065`*^9, 3.9034374351699505`*^9}, {3.903437587724994*^9, 
  3.9034375953639264`*^9}, {3.9034399748959885`*^9, 3.9034399913136864`*^9}, {
  3.9035085681400843`*^9, 3.903508607597818*^9}, {3.9035931854093113`*^9, 
  3.903593202168083*^9}, {3.9035937377322135`*^9, 3.903593759914888*^9}, {
  3.903593970582264*^9, 3.903593975006222*^9}, {3.903598950818987*^9, 
  3.9035989667074137`*^9}, {3.9036714803658895`*^9, 3.9036714824089766`*^9}, {
