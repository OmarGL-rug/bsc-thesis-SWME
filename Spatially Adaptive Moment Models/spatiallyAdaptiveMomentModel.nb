Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Hee", " ", "we", " ", "use", " ", "the", " ", "model", " ", "for", " ", 
     "the", " ", "extended", " ", "vector", " ", "in", " ", "the", " ", 
     "cells", " ", "at", " ", "the", " ", "interface", " ", "and", " ", 
     "apply", " ", "a", " ", "correction", " ", "for", " ", "not", " ", 
     "having", " ", "a", " ", "non"}], "-", 
    RowBox[{
    "zero", " ", "value", " ", "for", " ", "the", " ", "last", " ", "moment", 
     " ", "in", " ", "the", " ", "cell", " ", "left", " ", "of", " ", "the", 
     " ", "interface"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ExtendedModelAtInterface", "[", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ATildeLastColumns", "=", "ATilde"}], ";", "\[IndentingNewLine]", 
     RowBox[{"QTildeLastColumns", "=", "QTilde"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ATildeLastColumns", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"QTildeLastColumns", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RoeExtendedModel", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"nxL", "+", "2"}], ",", 
         RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
      RowBox[{"-", "ATilde"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"RoeExtendedModel", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nxL", "+", "2"}], ",", 
          RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{
          RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
          RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RoeExtendedModel", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"nxL", "+", "2"}], ",", 
         RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
