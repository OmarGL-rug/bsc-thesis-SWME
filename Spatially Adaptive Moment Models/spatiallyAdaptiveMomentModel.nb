Cell[CellGroupData[{

Cell["Numerical data post processing", "Section",
 CellChangeTimes->{{3.89859140932911*^9, 
  3.898591444316496*^9}},ExpressionUUID->"8076849a-b71a-488d-9a1c-\
495aa7d8da8c"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Collect", " ", "values", " ", "that", " ", "correspond", " ", "to", " ", 
   "the", " ", "same", " ", "moments"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.898846221551136*^9, 
  3.8988462565057273`*^9}},ExpressionUUID->"7d967bb1-79e7-42ea-9f5d-\
c4cd2b84c3d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"moments", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"moment", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "0"}], ",", 
     RowBox[{"i", "<", "momentsRight"}], ",", 
     RowBox[{"i", "++"}], ",", 
     RowBox[{
      RowBox[{"moment", "[", "i", "]"}], "=", 
      RowBox[{"{", "}"}]}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "0"}], ",", 
   RowBox[{"i", "<", "nxL"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "0"}], ",", 
     RowBox[{"j", "<", 
      RowBox[{"momentsRight", "-", "numberOfMomentsDifference"}]}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"moment", "[", "j", "]"}], "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"moment", "[", "j", "]"}], ",", 
        RowBox[{"W", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], "]"}], 
         "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "0"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"nxR", "+", "1"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "0"}], ",", 
     RowBox[{"j", "<", "momentsRight"}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"moment", "[", "j", "]"}], "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"moment", "[", "j", "]"}], ",", 
        RowBox[{"W", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"momentsLeft", "*", "nxL"}], "+", 
           RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], "]"}], 
         "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.898594980363446*^9, 3.8985949953612814`*^9}, {
   3.898595048349387*^9, 3.8985951193513613`*^9}, {3.8985957329249463`*^9, 
