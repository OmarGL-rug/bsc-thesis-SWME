\>", "Text",
 CellChangeTimes->{{3.9038620490063505`*^9, 3.903862138853737*^9}},
 FontSize->18,ExpressionUUID->"1012728a-94d5-4e6e-ab5b-16918ada4791"],

Cell[CellGroupData[{

Cell["Construct vector with initial values", "Subsection",
 CellChangeTimes->{{3.9028178214291515`*^9, 
  3.9028178421594133`*^9}},ExpressionUUID->"cbbcfa48-923d-493e-b528-\
09c37a3a72aa"],

Cell["Construct vector with the chosen initial values.", "Text",
 CellChangeTimes->{{3.9038623148569927`*^9, 3.9038623329932117`*^9}},
 FontSize->16,ExpressionUUID->"b99683e7-4cce-4777-86b3-a182621fa7e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitializeVector", "[", 
    RowBox[{
    "initialValuesLeft_", ",", "initialValuesRight_", ",", "epsilon_", ",", 
     "momentsBig_", ",", "momentsLeft_", ",", "momentsRight_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "values", ",", "valuesReference", ",", "momentSmall", ",", 
       "initialValuesLeft2", ",", "initialValuesRight2", ",", 
       "initialValuesLeftReference", ",", "initialValuesRightReference"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"momentSmall", "=", "epsilon"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Construct", " ", "the", " ", "inital", " ", "value", " ", "vector", 
         " ", "in", " ", "every", " ", "part", " ", "of", " ", "the", " ", 
         "domain", " ", "step"}], "-", "by", "-", "step"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesLeft2", "=", "initialValuesLeft"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesRight2", "=", "initialValuesRight"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initialValuesLeftReference", " ", "=", "initialValuesLeft"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"initialValuesRightReference", "=", "initialValuesRight"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsLeft"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"initialValuesLeft2", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesLeft2", ",", "momentsBig"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"initialValuesRight2", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRight2", ",", "momentsBig"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"initialValuesLeftReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesLeftReference", ",", "momentsBig"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"initialValuesRightReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRightReference", ",", "momentsBig"}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"momentsLeft", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"initialValuesRight2", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRight2", ",", "momentSmall"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"initialValuesLeftReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesLeftReference", ",", "momentSmall"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"initialValuesRightReference", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"initialValuesRightReference", ",", "momentSmall"}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Construct", " ", "big", " ", "initial", " ", "vector", " ", "by", " ",
         "stacking", " ", "the", " ", "initial", " ", "vectors", " ", "in", 
        " ", "each", " ", "cell"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Wraw", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"WrawReference", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "nxL"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"values", "[", "i", "]"}], "=", "initialValuesLeft2"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Wraw", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"Wraw", ",", 
            RowBox[{"values", "[", "i", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"valuesReference", "[", "i", "]"}], "=", 
          "initialValuesLeftReference"}], ";", "\[IndentingNewLine]", 
         RowBox[{"WrawReference", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"WrawReference", ",", 
            RowBox[{"valuesReference", "[", "i", "]"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"values", "[", "nxL", "]"}], "=", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"initialValuesLeft2", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "numberOfMomentsDifference"}], "}"}]}], "]"}]}], 
      ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Take", " ", "initial", " ", "values", " ", "from", " ", "the", " ", 
        "left", " ", "and", " ", "add", " ", "zeroes"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Wraw", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"Wraw", ",", 
         RowBox[{"values", "[", "nxL", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"valuesReference", "[", "nxL", "]"}], "=", 
       "initialValuesLeftReference"}], ";", "\[IndentingNewLine]", 
