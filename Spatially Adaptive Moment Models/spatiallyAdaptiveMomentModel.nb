Cell["Time stepping method for the reference solution.", "Text",
 CellChangeTimes->{{3.9038685249310627`*^9, 3.903868545812598*^9}, 
   3.9038686791790977`*^9},
 FontSize->16,ExpressionUUID->"35fe4b58-e269-4ee7-b055-286cd13db660"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeReference", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WReference", "=", "WrawReference"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeReference", ",", "outputReference"}], "}"}], "=", 
       "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
            "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
            "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"WReference", "=", 
            RowBox[{"WReference", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixFlattenReference", ".", "WReference"}]}]}]}],
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"WReference", "=", 
            RowBox[{"SourceTermMatrixReference", ".", "WReference"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsRight"}], "]"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "collection", " ", "of", " ", "each", " ", 
             "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"n", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"j", "=", "0"}], ",", 
                RowBox[{"j", "<", "momentsRight"}], ",", 
                RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{
                    RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                    RowBox[{"WReference", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentReference", "[", "i", "]"}], "=", " ", 
               RowBox[{"momentLoop", "[", "i", "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
               RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", 
             " ", 
             RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
             RowBox[{"f2", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"\[Sqrt]", "2"}]], 
               RowBox[{"(", 
                RowBox[{"\[Rho]T", "+", 
                 SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"densityReference", "=", 
            RowBox[{"momentReference", "[", "0", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"velocityReference", "=", 
            FractionBox[
             RowBox[{"momentReference", "[", "1", "]"}], 
             "densityReference"]}], ";", "\[IndentingNewLine]", 
           RowBox[{"temperatureReference", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"\[Sqrt]", "2"}], "*", 
               RowBox[{"momentReference", "[", "2", "]"}]}], "-", 
              RowBox[{
              "densityReference", "*", "velocityReference", "*", 
               "velocityReference"}], "+", "densityReference"}], 
             "densityReference"]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"time", " ", "=", " ", 
            RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.902810517096759*^9, {3.90281064731122*^9, 3.902810654867694*^9}, {
   3.903868682582562*^9, 3.9038687215765476`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"bf65fd98-6242-4e53-9273-bebf8017e533"]
}, Closed]],

