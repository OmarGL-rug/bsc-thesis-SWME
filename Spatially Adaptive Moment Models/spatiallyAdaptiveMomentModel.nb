Cell[CellGroupData[{

Cell["Construction of Reference Solution", "Section",
 CellChangeTimes->{{3.9017138450740876`*^9, 3.9017138492386293`*^9}, {
  3.9026462151530695`*^9, 
  3.9026462227606544`*^9}},ExpressionUUID->"3302a49e-9607-4b36-8fd3-\
f1a0750fb45d"],

Cell["\<\
As reference solution, we consider the numerical solution we obtain if we \
used the bigger matrix in the whole domain. \
\>", "Text",
 CellChangeTimes->{{3.903860577380809*^9, 3.9038606035230646`*^9}},
 FontSize->18,ExpressionUUID->"4d6d6d0a-d496-4649-ba3e-c3d82b19d657"],

Cell[CellGroupData[{

Cell["Source Term", "Subsection",
 CellChangeTimes->{{3.9026464043234673`*^9, 
  3.9026464070493793`*^9}},ExpressionUUID->"38705eab-fdf3-4be4-a17b-\
e5875d8da334"],

Cell["\<\
Construction of the source term matrix for the reference system.\
\>", "Text",
 CellChangeTimes->{{3.9038607733774614`*^9, 3.903860781079492*^9}},
 FontSize->16,ExpressionUUID->"6d5f2dc8-7c38-4ebf-884a-0e95c8673c45"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTermReference", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
     "momentsRight_", ",", "Relaxation_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "SourceMatrixRight", ",", "SourceMatrixReference", ",", 
       "SourceTermVectorReference", ",", "SourceTermVectorRight"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "the", " ", "RHS", " ", "source", " ", "term"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "assume", " ", "a", " ", "BGK"}], "-", 
        RowBox[{
        "type", " ", "operator", " ", "and", " ", "we", " ", "assume", " ", 
         "that", " ", "the", " ", "source", " ", "term", " ", "matrix", " ", 
         "is", " ", "a", " ", "diagonal", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceMatrixReference", " ", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceMatrixRight", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "i_"}], "}"}], "/;", 
            RowBox[{"i", ">=", "4"}]}], "\[RuleDelayed]", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "2"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", "i"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceMatrixReference", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", 
               RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"SourceMatrixReference", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", "SourceMatrixRight"}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"i", "+", "1"}]}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"n", "+", "2"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SourceMatrixReference", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
              "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorRight", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorReference", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorReference", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
           "SourceTermVectorReference", ",", "SourceTermVectorRight"}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "vector"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorReference", "=", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "Relaxation"]}], "*", 
        "SourceTermVectorReference"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorReference", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVectorReference", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrixReference", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVectorReference", "]"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
