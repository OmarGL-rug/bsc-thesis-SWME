Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeExtendedModel", "[", "tend_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
     RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "timeSpatiallyAdaptiveExtendedModel", ",", "outputSpatiallyAdaptive"}],
        "}"}], "=", "\[IndentingNewLine]", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
           "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
           "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"W", "=", 
           RowBox[{"W", "+", 
            RowBox[{"dt", "*", 
             RowBox[{"BigAMatrixExtendedModelFlatten", ".", "W"}]}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"W", "=", 
           RowBox[{"SourceTermMatrix", ".", "W"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsLeft"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1", "+", "momentsLeft"}], "]"}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                 RowBox[{"momentsRight", "*", 
                  RowBox[{"(", 
                   RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                 RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Update", " ", "collection", " ", "of", " ", "each", " ", 
            "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"momentLoop", "[", "i", "]"}], "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "nxL"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "0"}], ",", 
              RowBox[{"j", "<", "momentsLeft"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentLoop", "[", "j", "]"}], "=", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                 RowBox[{"W", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], 
                   "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<=", 
             RowBox[{"nxR", "+", "1"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "0"}], ",", 
              RowBox[{"j", "<", "momentsRight"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentLoop", "[", "j", "]"}], "=", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                 RowBox[{"W", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                    RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], 
                   "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"moment", "[", "i", "]"}], "=", 
              RowBox[{"momentLoop", "[", "i", "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
              RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", " ", 
            RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
            RowBox[{"f2", "=", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"\[Sqrt]", "2"}]], 
              RowBox[{"(", 
               RowBox[{"\[Rho]T", "+", 
                SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"density", "=", 
           RowBox[{"moment", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"velocity", "=", 
           FractionBox[
            RowBox[{"moment", "[", "1", "]"}], "density"]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"temperature", "=", 
           FractionBox[
            RowBox[{
             RowBox[{
              RowBox[{"\[Sqrt]", "2"}], "*", 
              RowBox[{"moment", "[", "2", "]"}]}], "-", 
             RowBox[{"density", "*", "velocity", "*", "velocity"}], "+", 
             "density"}], "density"]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"time", " ", "=", " ", 
           RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
