   RowBox[{
   "This", " ", "computes", " ", "the", " ", "eigenvalue", " ", "with", " ", 
    "the", " ", "biggest", " ", "real", " ", "part"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Eigenvalues", "[", 
   RowBox[{"StabilityMatrix", ",", "1", ",", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Arnoldi\>\"", ",", 
       RowBox[{"\"\<Criteria\>\"", "->", "\"\<RealPart\>\""}], ",", 
       RowBox[{"\"\<MaxIterations\>\"", "->", "10000"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
