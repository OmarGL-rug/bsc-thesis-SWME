        RowBox[{"WrawReference", ",", 
         RowBox[{"valuesReference", "[", "nxL", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"nxR", "+", "1"}]}], ",", 
