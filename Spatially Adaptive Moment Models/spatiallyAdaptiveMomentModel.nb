Cell["Time stepping method for the reference solution.", "Text",
 CellChangeTimes->{{3.9038685249310627`*^9, 3.903868545812598*^9}, 
   3.9038686791790977`*^9},
 FontSize->16,ExpressionUUID->"35fe4b58-e269-4ee7-b055-286cd13db660"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeReference", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WReference", "=", "WrawReference"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeReference", ",", "outputReference"}], "}"}], "=", 
       "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
            "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
            "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"WReference", "=", 
            RowBox[{"WReference", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixFlattenReference", ".", "WReference"}]}]}]}],
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"WReference", "=", 
            RowBox[{"SourceTermMatrixReference", ".", "WReference"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsRight"}], "]"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "collection", " ", "of", " ", "each", " ", 
             "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"n", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"j", "=", "0"}], ",", 
                RowBox[{"j", "<", "momentsRight"}], ",", 
                RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                  RowBox[{"Append", "[", 
                   RowBox[{
                    RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                    RowBox[{"WReference", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentReference", "[", "i", "]"}], "=", " ", 
               RowBox[{"momentLoop", "[", "i", "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
               RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", 
             " ", 
             RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
             RowBox[{"f2", "=", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"\[Sqrt]", "2"}]], 
               RowBox[{"(", 
                RowBox[{"\[Rho]T", "+", 
                 SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"densityReference", "=", 
            RowBox[{"momentReference", "[", "0", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"velocityReference", "=", 
            FractionBox[
             RowBox[{"momentReference", "[", "1", "]"}], 
             "densityReference"]}], ";", "\[IndentingNewLine]", 
           RowBox[{"temperatureReference", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"\[Sqrt]", "2"}], "*", 
               RowBox[{"momentReference", "[", "2", "]"}]}], "-", 
              RowBox[{
              "densityReference", "*", "velocityReference", "*", 
               "velocityReference"}], "+", "densityReference"}], 
             "densityReference"]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"time", " ", "=", " ", 
            RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.902810517096759*^9, {3.90281064731122*^9, 3.902810654867694*^9}, {
   3.903868682582562*^9, 
   3.9038687215765476`*^9}},ExpressionUUID->"bf65fd98-6242-4e53-9273-\
bebf8017e533"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Comparison between reference solution and spatially adaptive moment model\
\>", "Subsection",
 CellChangeTimes->{{3.902811143319135*^9, 3.9028111587651825`*^9}, {
  3.902811267421636*^9, 3.902811275738428*^9}, {3.9028113872476635`*^9, 
  3.9028113912926393`*^9}, {3.9028114452871933`*^9, 
  3.902811449282693*^9}},ExpressionUUID->"4bdcfae5-fa54-4e88-8ad0-\
a3986e675dd7"],

Cell["\<\
Simultaneous simulation of spatially adaptive moment model and reference \
solution\
\>", "Text",
 CellChangeTimes->{{3.9040508658688874`*^9, 3.904050869235757*^9}, {
  3.904050920795635*^9, 3.9040509332267895`*^9}, {3.904051086184588*^9, 
  3.9040510922471185`*^9}},
 FontSize->16,ExpressionUUID->"cfc1eeec-ed31-4287-9480-64552f441a41"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeComparison", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "norm", ",", "normRemainder", ",", "WeightedSumRoe", ",", 
       "WeightedSumViscosity", ",", "modelDiffA", ",", "modelDiffQ"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WReference", "=", "WrawReference"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeSpatiallyAdaptive", ",", "outputSpatiallyAdaptive"}], 
        "}"}], "=", "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Compute", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
            "point", " ", "s0", " ", "along", " ", "the", " ", "path"}], " ", 
           "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"i", "<=", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"norm", "+=", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
