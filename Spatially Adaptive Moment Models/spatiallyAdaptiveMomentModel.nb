Notebook[{

Cell[CellGroupData[{
Cell["Spatially Adaptive Finite Volume Method For Moment Models", "Title",
 CellChangeTimes->{{3.898846352317824*^9, 
  3.8988463801127234`*^9}},ExpressionUUID->"b5bb8d31-6c21-4c07-b145-\
bd591ca3144f"],

Cell[TextData[StyleBox["This Mathematica file implements a spatially adaptive \
finite volume method for moment models. The spatial adaptivity allows the \
simulation to use a different number of moments (and so different models) in \
different parts of the domain. Currently, the setting is the following: the \
domain is divided in 2 subdomains. In the left subdomain, the number of \
moments (=: ML) is smaller than the number of moments (=: MR) in the right \
subdomain. ",
 FontSize->36]], "Text",
 CellChangeTimes->{{3.898844431792612*^9, 3.8988445510433235`*^9}, {
  3.898845306130126*^9, 
  3.898845331313634*^9}},ExpressionUUID->"74e8218b-1200-46e1-a2a6-\
f6c6cf14575e"],

Cell[CellGroupData[{

Cell["Simulation setup", "Section",
 CellChangeTimes->{{3.898331665583954*^9, 
  3.8983316682653613`*^9}},ExpressionUUID->"7f05c00e-2e56-4ffb-a781-\
610f5015259b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Choose", " ", "number", " ", "of", " ", "cells", " ", "in", " ", "left", 
    " ", "and", " ", "right", " ", "subdomain"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nxL", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nxR", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"nxL", "+", "nxR"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Choose", " ", "boundaries", " ", "of", " ", "the", " ", "spatial", " ", 
     "domain"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "=", 
     RowBox[{"-", "10"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x2", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", "=", 
     FractionBox[
      RowBox[{"x2", "-", "x1"}], 
      RowBox[{"nxL", "+", "nxR"}]]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Choose", " ", "number", " ", "of", " ", "moments", " ", "in", " ", 
     "left", " ", "and", " ", "right", " ", "subdomain"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentsLeft", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentsRight", "=", "6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numberOfMomentsDifference", "=", 
     RowBox[{"momentsRight", "-", "momentsLeft"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Choose", " ", "initial", " ", "values"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m0", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m1", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m2", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epsilon", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentsBig", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentSmall", "=", "epsilon"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initialValuesLeft", "=", 
     RowBox[{"{", 
      RowBox[{"m0", ",", "m1", ",", "m2"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initialValuesRight", "=", 
     RowBox[{"{", 
      RowBox[{"m0", ",", "m1", ",", "m2"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "4"}], ",", 
      RowBox[{"i", "<=", "momentsLeft"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"initialValuesLeft", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"initialValuesLeft", ",", "momentsBig"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"initialValuesRight", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"initialValuesRight", ",", "momentsBig"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", 
       RowBox[{"momentsLeft", "+", "1"}]}], ",", 
      RowBox[{"i", "<=", "momentsRight"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"initialValuesRight", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"initialValuesRight", ",", "momentSmall"}], "]"}]}], ";"}]}],
      "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Choose", " ", "Relaxation", " ", "time"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Relaxation", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "0"}], ",", 
      RowBox[{"i", "<", "nxL"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"values", "[", "i", "]"}], "=", "initialValuesLeft"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"W", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"W", ",", 
          RowBox[{"values", "[", "i", "]"}]}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"values", "[", "nxL", "]"}], "=", 
     RowBox[{"ArrayPad", "[", 
      RowBox[{"initialValuesLeft", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "numberOfMomentsDifference"}], "}"}]}], "]"}]}], 
    ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Take", " ", "initial", " ", "values", " ", "from", " ", "the", " ", 
      "left", " ", "and", " ", "add", " ", "zeroes"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"W", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"W", ",", 
       RowBox[{"values", "[", "nxL", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{"nxR", "+", "1"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"values", "[", 
         RowBox[{"i", "+", "nxL"}], "]"}], "=", "initialValuesRight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"W", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"W", ",", 
          RowBox[{"values", "[", 
           RowBox[{"i", "+", "nxL"}], "]"}]}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Choose", " ", "time", " ", "step"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dt", "=", 
     RowBox[{"0.1", "dx"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"time", "=", " ", "0.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"step", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Choose", " ", "end", " ", "time"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tend", "=", "1.5"}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
 InitializationCell->True,
