Cell["Using the bigger model", "Subsubsection",
 CellChangeTimes->{{3.903437085609008*^9, 
  3.9034371040450153`*^9}},ExpressionUUID->"c9ded7bb-8c8a-4263-9686-\
420485f50a01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Hee", " ", "we", " ", "use", " ", "the", " ", "bigger", " ", "model", 
     " ", "in", " ", "the", " ", "cells", " ", "at", " ", "the", " ", 
     "interface", " ", "and", " ", "apply", " ", "a", " ", "correction", " ", 
     "for", " ", "not", " ", "having", " ", "a", " ", "non"}], "-", 
    RowBox[{
    "zero", " ", "value", " ", "for", " ", "the", " ", "last", " ", "moment", 
     " ", "in", " ", "the", " ", "cell", " ", "left", " ", "of", " ", "the", 
     " ", "interface"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BiggerModelAtInterface", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ARightLastColumns", "=", "ARight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"QRightLastColumns", "=", "QRight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ARightLastColumns", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"QRightLastColumns", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "momentsLeft"}]}], "]"}], "]"}], "=", "0"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RoeBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "ARight"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"RoeBiggerModel", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nxL", "+", "2"}], ",", 
            RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{
            RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
            RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RoeBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "ARightLastColumns"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RoeBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", "ARight"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ViscosityBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"ViscosityBiggerModel", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nxL", "+", "2"}], ",", 
            RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{
            RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
            RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ViscosityBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"2", "*", "QRight"}], "-", "QRightLastColumns"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ViscosityBiggerModel", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"nxL", "+", "2"}], ",", 
           RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", 
        RowBox[{"-", "QRight"}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
