Cell["\<\
Construction of the Roe matrix and the viscosity matrix for the reference \
system.\
\>", "Text",
 CellChangeTimes->{{3.903860817007146*^9, 3.9038608340900097`*^9}},
 FontSize->16,ExpressionUUID->"6975cd56-0c25-4609-a1dc-b723cd889de4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ConstructMatrixReference", "[", 
     RowBox[{
     "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "dx_", ",", 
      "momentsLeft_", ",", "momentsRight_", ",", "Relaxation_", ",", "dt_"}], 
     "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"RoeReference", ",", "ViscosityReference"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RoeReference", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityReference", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "+", "2"}], ",", 
            RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
         "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReference", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReference", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "All", " ", "rows", " ", "apart", " ", "from", " ", "the", " ", 
         "first", " ", "and", " ", "the", " ", "last"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"n", "+", "1"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReference", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "ARight"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeReference", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"RoeReference", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "ARight"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReference", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReference", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"2", "*", "QRight"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReference", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
           RowBox[{"-", "QRight"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<", 
             RowBox[{"i", "-", "1"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeReference", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ViscosityReference", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
               "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "2"}]}], ",", 
            RowBox[{"j", "<=", 
             RowBox[{"n", "+", "2"}]}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"RoeReference", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ViscosityReference", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
               "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Last", " ", "rows", " ", "are", " ", "ghost", " ", "rows"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{"n", "+", "2"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"RoeReference", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "+", "2"}], ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ViscosityReference", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "+", "2"}], ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}],
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Call", " ", "the", " ", "method", " ", "that", " ", "constructs", 
         " ", "the", " ", "source", " ", "term", " ", "for", " ", "the", " ", 
         "reference", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ConstructSourceTermReference", "[", 
        RowBox[{
        "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "momentsLeft", ",", 
         "momentsRight", ",", "Relaxation", ",", "dt"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Obtain", " ", "full", " ", "Roe", " ", "matrix", " ", "and", " ", 
         "full", " ", "viscosity", " ", "matrix", " ", "from", " ", "their", 
         " ", "block", " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"RoeFlattenReference", " ", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "RoeReference", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ViscosityFlattenReference", " ", "=", " ", 
        RowBox[{"ArrayFlatten", "[", "ViscosityReference", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Obtain", " ", "transport", " ", "part", " ", "of", " ", "spatial", 
         " ", "discretization", " ", "matrix", " ", "for", " ", "the", " ", 
         "reference", " ", "system", " ", "from", " ", "Roe", " ", "block", 
         " ", "matrix", " ", "and", " ", "viscosity", " ", "block", " ", 
         "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BigAMatrixReference", "=", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1.0", 
           RowBox[{"2", "*", "dx"}]]}], "*", 
         RowBox[{"(", 
          RowBox[{"RoeReference", "+", "ViscosityReference"}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"BigAMatrixFlattenReference", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1.0", 
           RowBox[{"2", "*", "dx"}]]}], "*", 
         RowBox[{"(", 
          RowBox[{"RoeFlattenReference", "+", "ViscosityFlattenReference"}], 
          ")"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
