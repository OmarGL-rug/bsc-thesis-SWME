Cell[CellGroupData[{

Cell["\<\
Spatially Adaptive Moment Model with using the model for the extended vector \
at the interface between the two models\
\>", "Subsection",
 CellChangeTimes->{{3.9029825020123587`*^9, 
  3.902982542853181*^9}},ExpressionUUID->"9ab53544-f0e3-4654-9587-\
07d3d303d0c2"],

Cell["\<\
Using the model for the extended vector in the equation for the cell right of \
the interface between the two models.\
\>", "Text",
 CellChangeTimes->{{3.9038680233728495`*^9, 3.9038680327490654`*^9}, 
   3.903868663135624*^9},
 FontSize->16,ExpressionUUID->"dcc93f08-9207-4de2-a019-fb12f041c45e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeExtendedModel", "[", "tend_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
     RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"timeSpatiallyAdaptive", ",", "outputSpatiallyAdaptive"}], 
       "}"}], "=", "\[IndentingNewLine]", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "SPLITTING", " ", "OF", " ", "EQUATION", " ", "IN", " ", 
           "TRANSPORT", " ", "STEP", " ", "AND", " ", "RELAXATION", " ", 
           "STEP"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"W", "=", 
           RowBox[{"W", "+", 
            RowBox[{"dt", "*", 
             RowBox[{"BigAMatrixExtendedModelFlatten", ".", "W"}]}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"W", "=", 
           RowBox[{"SourceTermMatrix", ".", "W"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsLeft"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1", "+", "momentsLeft"}], "]"}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                 RowBox[{"momentsRight", "*", 
                  RowBox[{"(", 
                   RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                "]"}], "]"}], "=", 
              RowBox[{"W", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                 RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Update", " ", "collection", " ", "of", " ", "each", " ", 
            "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"momentLoop", "[", "i", "]"}], "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "nxL"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "0"}], ",", 
              RowBox[{"j", "<", "momentsLeft"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentLoop", "[", "j", "]"}], "=", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                 RowBox[{"W", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], 
                   "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<=", 
             RowBox[{"nxR", "+", "1"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "0"}], ",", 
              RowBox[{"j", "<", "momentsRight"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentLoop", "[", "j", "]"}], "=", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                 RowBox[{"W", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                    RowBox[{"momentsRight", "*", "i"}], "+", "j", "+", "1"}], 
                   "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "0"}], ",", 
            RowBox[{"i", "<", "momentsRight"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"moment", "[", "i", "]"}], "=", 
              RowBox[{"momentLoop", "[", "i", "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"For", " ", "the", " ", "Hermite", " ", "spectral", " ", 
              RowBox[{"method", ":", " ", "f0"}]}], "=", "\[Rho]"}], ",", " ", 
            RowBox[{"f1", "=", "\[Rho]u"}], ",", " ", 
            RowBox[{"f2", "=", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"\[Sqrt]", "2"}]], 
              RowBox[{"(", 
               RowBox[{"\[Rho]T", "+", 
                SuperscriptBox["\[Rho]u", "2"], "-", "\[Rho]"}], ")"}]}]}]}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"density", "=", 
           RowBox[{"moment", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"velocity", "=", 
           FractionBox[
            RowBox[{"moment", "[", "1", "]"}], "density"]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"temperature", "=", 
           FractionBox[
            RowBox[{
             RowBox[{
              RowBox[{"\[Sqrt]", "2"}], "*", 
              RowBox[{"moment", "[", "2", "]"}]}], "-", 
             RowBox[{"density", "*", "velocity", "*", "velocity"}], "+", 
             "density"}], "density"]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"time", " ", "=", " ", 
           RowBox[{"time", "+", "dt"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", ")"}]}], 
  ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.902984633968362*^9, {3.9030115347136626`*^9, 3.9030115840333734`*^9}, {
   3.9030117300943937`*^9, 3.903011753243002*^9}, {3.9034375434869003`*^9, 
   3.903437544218892*^9}, 3.903511461151074*^9, {3.9038684919351664`*^9, 
   3.903868499971425*^9}, 
   3.903868673018405*^9},ExpressionUUID->"17d2e890-0432-4750-a373-\
1fdfcb2b149b"]
}, Closed]],

Cell[CellGroupData[{

Cell["Reference Solution", "Subsection",
 CellChangeTimes->{{3.9026535950210466`*^9, 
  3.9026535986530333`*^9}},ExpressionUUID->"2f30bef8-4a69-46f6-b70e-\
