Cell[CellGroupData[{

Cell["Set up model", "Subsection",
 CellChangeTimes->{{3.9028177926869583`*^9, 3.9028178066772966`*^9}, {
  3.9038676760882425`*^9, 
  3.903867677865839*^9}},ExpressionUUID->"86c15b6e-5e09-4496-9266-\
b7825a42e390"],

Cell["\<\
Set spatial discretization parameters and call the spatial discretization \
matrix construction functions.\
\>", "Text",
 CellChangeTimes->{{3.9038627462816133`*^9, 3.9038627732352576`*^9}, 
   3.9038631491611505`*^9},
 FontSize->16,ExpressionUUID->"7438f02d-0ff0-4eae-b342-3cba38e5933d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InitializeModel", "[", 
     RowBox[{
     "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
      "momentsRight_", ",", "initialValuesLeft_", ",", "initialValuesRight_", 
      ",", "epsilon_", ",", "momentsBig_", ",", "Relaxation_"}], "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"numberOfMomentsDifference", "=", 
       RowBox[{"momentsRight", "-", "momentsLeft"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"nxL", "+", "nxR"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"dx", "=", 
       FractionBox[
        RowBox[{"x2", "-", "x1"}], 
        RowBox[{"nxL", "+", "nxR"}]]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"InitializeVector", "[", 
       RowBox[{
       "initialValuesLeft", ",", "initialValuesRight", ",", "epsilon", ",", 
        "momentsBig", ",", "momentsLeft", ",", "momentsRight"}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Initialize", " ", "the", " ", "collection", " ", "of", " ", "the", 
        " ", "moments"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"moments", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"moment", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"momentsReference", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"momentReference", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"momentsLoop", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"moment", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"momentsRight", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"moment", "[", "i", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"momentReference", "[", "i", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Choose", " ", "time", " ", "step"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dt", "=", 
       RowBox[{"0.1", "dx"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"ConstructMatrix", "[", 
       RowBox[{
       "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", "momentsLeft",
         ",", "momentsRight", ",", "Relaxation", ",", "dt"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ConstructMatrixReference", "[", 
       RowBox[{
       "nxL", ",", "nxR", ",", "x1", ",", "x2", ",", "dx", ",", "momentsLeft",
         ",", "momentsRight", ",", "Relaxation", ",", "dt"}], "]"}], ";"}], 
     "\[IndentingNewLine]", ")"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8983327313032255`*^9, 3.8983327383165236`*^9}, {
