Notebook[{

Cell[CellGroupData[{
Cell["Spatially Adaptive Finite Volume Method For Moment Models", "Title",
 CellChangeTimes->{{3.898846352317824*^9, 
  3.8988463801127234`*^9}},ExpressionUUID->"b5bb8d31-6c21-4c07-b145-\
bd591ca3144f"],

Cell[TextData[StyleBox["This Mathematica file implements a spatially adaptive \
finite volume method for moment models. The spatial adaptivity allows the \
simulation to use a different number of moments (and so different models) in \
different parts of the domain. Currently, the setting is the following: the \
domain is divided in 2 subdomains. In the left subdomain, the number of \
moments (=: ML) is smaller than the number of moments (=: MR) in the right \
subdomain. \nIn this code, the interface between the two models is at the \
shock.",
 FontSize->36]], "Text",
 CellChangeTimes->{{3.898844431792612*^9, 3.8988445510433235`*^9}, {
  3.898845306130126*^9, 3.898845331313634*^9}, {3.902914628610138*^9, 
  3.9029146689989758`*^9}},ExpressionUUID->"74e8218b-1200-46e1-a2a6-\
f6c6cf14575e"],

Cell[CellGroupData[{

Cell["Construction of Spatially Adaptive Moment Model", "Section",
 CellChangeTimes->{{3.8983311900025244`*^9, 3.8983312045160894`*^9}, {
  3.9026461987739944`*^9, 3.902646211242531*^9}, {3.902996923955519*^9, 
  3.902996924705532*^9}},ExpressionUUID->"7a3cef64-10b1-4b4a-b62e-\
d0fd8d3670c9"],

Cell[TextData[StyleBox["Construction of the spatial discretization matrix of \
the models. The construction is split into transport part (Roe matrix and \
viscosity matrix) and source term part (relaxation).",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.9038541922672596`*^9, 3.9038542645392313`*^9}},
 FontSize->16,ExpressionUUID->"d39567fa-d5ad-4299-9ba1-d2e4f272420f"],

Cell[CellGroupData[{

Cell["Source Term", "Subsection",
 CellChangeTimes->{{3.9026439467348037`*^9, 3.902643953751412*^9}, {
  3.9026453663618517`*^9, 3.902645369247607*^9}, {3.9026464090009727`*^9, 
  3.90264640931116*^9}},ExpressionUUID->"2b87209e-62e3-454d-9fdd-\
d320bd6dd480"],

Cell["Construction of the source term matrix.", "Text",
 CellChangeTimes->{{3.903854433884282*^9, 3.9038544491965017`*^9}},
 FontSize->16,ExpressionUUID->"6e29ac03-0711-417f-b7b3-4053defee365"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSourceTerm", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "momentsLeft_", ",", 
     "momentsRight_", ",", "Relaxation_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "SourceMatrixLeft", ",", "SourceMatrixRight", ",", "SourceMatrix", ",", 
       "SourceTermVectorLeft", ",", "SourceTermVectorRight", ",", 
       "SourceTermVector"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "the", " ", "RHS", " ", "source", " ", "term"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "assume", " ", "a", " ", "BGK"}], "-", 
        RowBox[{
        "type", " ", "operator", " ", "and", " ", "we", " ", "assume", " ", 
         "that", " ", "the", " ", "source", " ", "term", " ", "matrix", " ", 
         "is", " ", "a", " ", "diagonal", " ", "matrix"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SourceMatrixLeft", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "i_"}], "}"}], "/;", 
            RowBox[{"i", ">=", "4"}]}], "\[RuleDelayed]", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceMatrixRight", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "i_"}], "}"}], "/;", 
            RowBox[{"i", ">=", "4"}]}], "\[RuleDelayed]", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceMatrix", " ", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "nxL"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", "i"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceMatrix", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", 
               RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"SourceMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", "SourceMatrixLeft"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"i", "+", "1"}]}], ",", 
           RowBox[{"j", "<=", "nxL"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SourceMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}],
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"nxL", "+", "1"}]}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"n", "+", "2"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SourceMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"momentsLeft", ",", "momentsRight"}], "}"}]}], 
              "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"nxL", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "2"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", "nxL"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"SourceMatrix", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", 
               RowBox[{"momentsRight", ",", "momentsLeft"}], "}"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"nxL", "+", "1"}]}], ",", 
           RowBox[{"j", "<", "i"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SourceMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
              "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"SourceMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", "SourceMatrixRight"}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"i", "+", "1"}]}], ",", 
           RowBox[{"j", "++"}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"n", "+", "2"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SourceMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], 
              "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorLeft", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SourceTermVectorRight", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "4"}], ",", 
        RowBox[{"i", "<=", "momentsLeft"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorLeft", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorLeft", ",", "1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"momentsLeft", "+", "1"}]}], ",", 
        RowBox[{"i", "<=", "momentsRight"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVectorRight", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"SourceTermVectorRight", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<", "nxL"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", "SourceTermVectorLeft"}], "]"}]}],
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "nxL"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SourceTermVector", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"SourceTermVector", ",", "SourceTermVectorRight"}], 
           "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Obtain", " ", "source", " ", "term", " ", "vector"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "Relaxation"]}], "*", "SourceTermVector"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Obtain", " ", "Exponential", " ", "of", " ", "source", " ", "term", 
        " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SourceTermVector", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"SourceTermVector", "*", "dt"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SourceTermMatrix", "=", 
       RowBox[{"DiagonalMatrix", "[", "SourceTermVector", "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9026443436550684`*^9, 3.902644349713498*^9}, {
   3.90264439035752*^9, 3.90264445232934*^9}, {3.9026447547300086`*^9, 
   3.9026448094880157`*^9}, {3.9026450398203893`*^9, 3.902645041707831*^9}, 
   3.9026468582274456`*^9, {3.902647155618944*^9, 3.9026471583085127`*^9}, {
   3.902650460498855*^9, 3.9026504791238303`*^9}, {3.902651071332897*^9, 
   3.9026510725840483`*^9}, {3.902823517069681*^9, 3.9028235261578703`*^9}, {
   3.902824060423334*^9, 3.9028240655638695`*^9}, {3.9028241564725556`*^9, 
