       RowBox[{"[", 
        RowBox[{
         RowBox[{"nxL", "+", "2"}], ",", 
         RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", "ARight"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ViscosityExtendedModel", "[", 
