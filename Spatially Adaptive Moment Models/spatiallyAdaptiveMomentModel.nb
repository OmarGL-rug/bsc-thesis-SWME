      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "2"}], ",", 
        RowBox[{"i", "<", "nxL"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
