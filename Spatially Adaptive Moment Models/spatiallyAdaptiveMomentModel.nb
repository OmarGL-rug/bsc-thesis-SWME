Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FiniteVolumeSchemeComparison", "[", "tend_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "norm", ",", "normRemainder", ",", "WeightedSumRoe", ",", 
       "WeightedSumViscosity", ",", "modelDiffA", ",", "modelDiffQ"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Reset", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"W", "=", "Wraw"}], ";", "\[IndentingNewLine]", 
      RowBox[{"WReference", "=", "WrawReference"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"time", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"step", "=", "0"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"timeSpatiallyAdaptive", ",", "outputSpatiallyAdaptive"}], 
        "}"}], "=", "\[IndentingNewLine]", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Compute", " ", "the", " ", "values", " ", "of", " ", "the", " ", 
            "point", " ", "s0", " ", "along", " ", "the", " ", "path"}], " ", 
           "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"i", "<=", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"norm", "+=", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"W", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", "i"}], "]"}], 
                   "]"}], "-", 
                  RowBox[{"W", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", 
                    "+", "i"}], "]"}], "]"}]}], ")"}], "2"]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"normRemainder", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", 
              RowBox[{"momentsLeft", "+", "1"}]}], ",", 
             RowBox[{"i", "<=", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"normRemainder", "+=", 
               SuperscriptBox[
                RowBox[{"W", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"momentsLeft", "*", "nxL"}], "+", "momentsRight", 
                   "+", "i"}], "]"}], "]"}], "2"]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
               RowBox[{"Sqrt", "[", "normRemainder", "]"}]}], "==", "0"}], 
             ",", 
             RowBox[{"s0", "=", "0"}], ",", 
             RowBox[{"s0", "=", 
              FractionBox[
               RowBox[{"Sqrt", "[", "norm", "]"}], 
               RowBox[{
                RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
                RowBox[{"Sqrt", "[", "normRemainder", "]"}]}]]}]}], "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "THE", " ", "SYSTEM", " ", "MATRIX", " ", "HERE", " ", "IS", " ", 
             "A", " ", "WEIGHTED", " ", "SUM", " ", "OF", " ", "THE", " ", 
             "BIGGER", " ", "MATRIX", " ", "AND", " ", "THE", " ", "SMALLER", 
             " ", "MATRIX"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"WeightedSumRoe", "=", 
            RowBox[{
             RowBox[{"s0", "*", "ATilde"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "s0"}], ")"}], "*", "ARight"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"WeightedSumRoe", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{
                RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
                RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"WeightedSumViscosity", "=", 
            RowBox[{
             RowBox[{"s0", "*", "QTilde"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "s0"}], ")"}], "*", "QRight"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"WeightedSumViscosity", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{
                RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
                RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"modelDiffA", "=", 
            RowBox[{"ATilde", "-", "ARight"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"modelDiffQ", "=", 
            RowBox[{"QTilde", "-", "QRight"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"modelDiffA", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{
                RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
                RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"modelDiffQ", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{
                RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
                RowBox[{"-", "1"}]}]}], "]"}], "]"}], "=", "0"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"BigAMatrix", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"nxL", "+", "2"}], ",", 
               RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", " ", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"2", "*", "dx"}]]}], "*", 
             RowBox[{"(", 
              RowBox[{"WeightedSumRoe", "-", "WeightedSumViscosity"}], 
              ")"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"BigAMatrix", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"nxL", "+", "2"}], ",", 
               RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", " ", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"2", "*", "dx"}]]}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"s0", "*", "modelDiffA"}], "+", 
               RowBox[{"2", "*", "QRight"}], "+", 
               RowBox[{"s0", "*", 
                RowBox[{"(", "modelDiffQ", ")"}]}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"BigAMatrix", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"nxL", "+", "2"}], ",", 
               RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", " ", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"2", "*", "dx"}]]}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "ARight"}], "-", "QRight"}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"BigAMatrixFlatten", "=", 
            RowBox[{"ArrayFlatten", "[", "BigAMatrix", "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Transport", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"W", "=", 
            RowBox[{"W", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixFlatten", ".", "W"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"WReference", "=", 
            RowBox[{"WReference", "+", 
             RowBox[{"dt", "*", 
              RowBox[{"BigAMatrixFlattenReference", ".", "WReference"}]}]}]}],
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Relaxation", " ", "step"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"W", "=", 
            RowBox[{"SourceTermMatrix", ".", "W"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"WReference", "=", 
            RowBox[{"SourceTermMatrixReference", ".", "WReference"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Update", " ", "boundary", " ", "conditions"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsLeft"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsLeft"}], "]"}], "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"W", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsLeft", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1", "+", "momentsRight"}], "]"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", 
                   RowBox[{"(", 
                    RowBox[{"nxR", "+", "1"}], ")"}]}], "+", "i", "+", "1"}], 
                 "]"}], "]"}], "=", 
               RowBox[{"WReference", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"momentsRight", "*", "nxL"}], "+", 
                  RowBox[{"momentsRight", "*", "nxR"}], "+", "i", "+", "1"}], 
                 "]"}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Update", " ", "collection", " ", "of", " ", "each", " ", 
             "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "momentsRight"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"momentLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"momentReferenceLoop", "[", "i", "]"}], "=", 
               RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<", "nxL"}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"j", "=", "0"}], ",", 
               RowBox[{"j", "<", "momentsLeft"}], ",", 
               RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"momentLoop", "[", "j", "]"}], "=", 
                RowBox[{"Append", "[", 
                 RowBox[{
                  RowBox[{"momentLoop", "[", "j", "]"}], ",", 
                  RowBox[{"W", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"momentsLeft", "*", "i"}], "+", "j", "+", "1"}], 
                    "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "0"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"nxR", "+", "1"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"j", "=", "0"}], ",", 
               RowBox[{"j", "<", "momentsRight"}], ",", 
               RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
