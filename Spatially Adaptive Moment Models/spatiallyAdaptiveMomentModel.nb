Cell[CellGroupData[{

Cell["Eigenvalues of the full spatial discretization matrix", "Subsection",
 CellChangeTimes->{{3.901605753090415*^9, 
  3.901605769165597*^9}},ExpressionUUID->"c875962d-1af7-4358-a50b-\
bd6a06a27a9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Obtain", " ", "the", " ", "full", " ", "spatial", " ", "discretization", 
    " ", "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"StabilityMatrix", " ", "=", " ", 
    RowBox[{"BigAMatrixFlatten", "+", "SourceTermMatrix"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.901024037472849*^9, 3.9010240384597*^9}, {
  3.901024221476179*^9, 3.9010242333426037`*^9}, {3.901024312556155*^9, 
