 CellChangeTimes->{{3.9038589657079115`*^9, 3.9038589749769597`*^9}},
 FontSize->16,ExpressionUUID->"ed39a59a-0590-44db-98a4-17ec918cad5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstructMatrix", "[", 
    RowBox[{
    "nxL_", ",", "nxR_", ",", "x1_", ",", "x2_", ",", "dx_", ",", 
     "momentsLeft_", ",", "momentsRight_", ",", "Relaxation_", ",", "dt_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Define", " ", "the", " ", "model", " ", "matrices"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ALeft", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
             RowBox[{
              RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
            RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
             RowBox[{
              RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
            RowBox[{"Sqrt", "[", "i", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsLeft", ",", "momentsLeft"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ARight", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
             RowBox[{
              RowBox[{"i", "-", "j"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
            RowBox[{"Sqrt", "[", "j", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
             RowBox[{
              RowBox[{"j", "-", "i"}], "\[Equal]", "1"}]}], "\[RuleDelayed]", 
            RowBox[{"Sqrt", "[", "i", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"momentsRight", ",", "momentsRight"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"ATilde", "=", "ARight"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ATilde", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
           RowBox[{"-", "1"}]}], ",", "All"}], "]"}], "]"}], "=", "0"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Define", " ", "the", " ", "numerical", " ", "viscosity", " ", 
        "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"QLeft", "=", 
       RowBox[{"IdentityMatrix", "[", "momentsLeft", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"QRight", "=", 
       RowBox[{"IdentityMatrix", "[", "momentsRight", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"QTilde", "=", "QRight"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"QTilde", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "numberOfMomentsDifference"}], ";;", 
           RowBox[{"-", "1"}]}], ",", "All"}], "]"}], "]"}], "=", "0"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Initialize", " ", "block", " ", "matrices", " ", "for", " ", "the", 
        " ", "different", " ", "models"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"RoeWeightedSum", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ViscosityWeightedSum", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"RoeBiggerModel", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ViscosityBiggerModel", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"RoeExtendedModel", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ViscosityExtendedModel", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "2"}], ",", 
           RowBox[{"n", "+", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "CREATE", " ", "THE", " ", "SPATIAL", " ", "DISCRETIZATION", " ", 
        "MATRIX", " ", "BLOCK", " ", "BY", " ", "BLOCK"}], " ", "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "First", " ", "row", " ", "is", " ", "a", " ", "ghost", " ", "row"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ",", 
