Cell[CellGroupData[{

Cell["Simulation", "Section",
 CellChangeTimes->{{3.8983371885302954`*^9, 
  3.898337190022443*^9}},ExpressionUUID->"7b5519a0-42ee-4356-9f6e-\
2d8b73cb28e2"],

Cell[BoxData[
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{"time", "<", "tend"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"norm", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "4"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"norm", "+=", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"W", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"4", "*", "nxL"}], "+", "i"}], "]"}], "]"}], "-", 
           RowBox[{"W", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"4", "*", "nxL"}], "+", "5", "+", "i"}], "]"}], "]"}]}],
           ")"}], "2"]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
        RowBox[{"Abs", "[", 
         RowBox[{"W", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"4", "*", "nxL"}], "+", "10"}], "]"}], "]"}], "]"}]}], "==",
        "0"}], ",", 
      RowBox[{"s0", "=", "0"}], ",", 
      RowBox[{"s0", "=", 
       FractionBox[
        RowBox[{"Sqrt", "[", "norm", "]"}], 
        RowBox[{
         RowBox[{"Sqrt", "[", "norm", "]"}], "+", 
         RowBox[{"Abs", "[", 
          RowBox[{"W", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"4", "*", "nxL"}], "+", "10"}], "]"}], "]"}], 
          "]"}]}]]}]}], "]"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"WeightedSumRoe", "=", 
     RowBox[{
      RowBox[{"s0", "*", "ATilde"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "s0"}], ")"}], "*", "A4"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WeightedSumRoe", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "5"}], "]"}], "]"}], "=", "0"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"WeightedSumViscosity", "=", 
     RowBox[{
      RowBox[{"s0", "*", "QTilde"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "s0"}], ")"}], "*", "Q4"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WeightedSumViscosity", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "5"}], "]"}], "]"}], "=", "0"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BigAMatrix", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"nxL", "+", "2"}], ",", 
        RowBox[{"nxL", "+", "1"}]}], "]"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"2", "*", "dx"}]]}], "*", 
      RowBox[{"(", 
       RowBox[{"WeightedSumRoe", "-", "WeightedSumViscosity"}], ")"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BigAMatrix", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"nxL", "+", "2"}], ",", 
        RowBox[{"nxL", "+", "2"}]}], "]"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"2", "*", "dx"}]]}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s0", "*", 
         RowBox[{"(", 
          RowBox[{"ATilde", "-", "A4"}], ")"}]}], "+", 
        RowBox[{"2", "*", "Q4"}], "+", 
        RowBox[{"s0", "*", 
         RowBox[{"(", 
          RowBox[{"QTilde", "-", "Q4"}], ")"}]}]}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BigAMatrix", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"nxL", "+", "2"}], ",", 
        RowBox[{"nxL", "+", "3"}]}], "]"}], "]"}], "=", " ", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"2", "*", "dx"}]]}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "A4"}], "-", "Q4"}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"BigAMatrixFlatten", "=", 
     RowBox[{"ArrayFlatten", "[", "BigAMatrix", "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"W", "=", 
     RowBox[{"W", "+", 
      RowBox[{"dt", "*", 
       RowBox[{"BigAMatrixFlatten", ".", "W"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"time", " ", "=", " ", 
     RowBox[{"time", "+", "dt"}]}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.898337461164347*^9, 3.8983374911133657`*^9}, 
   3.898339169100921*^9, {3.8983392861301117`*^9, 3.8983393112700014`*^9}, {
