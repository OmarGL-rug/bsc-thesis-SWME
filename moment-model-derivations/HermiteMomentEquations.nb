  3.96942981543338*^9}},ExpressionUUID->"4933ad82-6fc6-6741-bc0e-\
3052a6750252"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"Mx", ">", "2"}], ",", 
    RowBox[{
     RowBox[{"transportMatrix", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "i_"}], "}"}], "\[RuleDelayed]", "u"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "\[RuleDelayed]", "\[Rho]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}], "\[RuleDelayed]", 
           FractionBox["\[Theta]", "\[Rho]"]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], "\[RuleDelayed]", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "2"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"2", "*", "\[Theta]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "4"}], "}"}], "\[RuleDelayed]", 
           FractionBox["6", "\[Rho]"]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "3"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"\[Rho]", "*", 
            FractionBox["\[Theta]", "2"]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">=", "4"}], "&&", 
             RowBox[{"j", "==", "1"}]}]}], " ", "\[RuleDelayed]", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"f", "[", 
              RowBox[{"i", "-", "2"}], "]"}]}], "*", 
            FractionBox["\[Theta]", "\[Rho]"]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">=", "4"}], "&&", 
             RowBox[{"j", "==", "2"}]}]}], " ", "\[RuleDelayed]", 
           RowBox[{"i", "*", 
            RowBox[{"f", "[", 
             RowBox[{"i", "-", "1"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">", "4"}], "&&", 
             RowBox[{"j", "==", "3"}]}]}], " ", "\[RuleDelayed]", 
           RowBox[{
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"i", "-", "4"}], "]"}], "*", 
             FractionBox["\[Theta]", "2"]}], "+", 
            RowBox[{
             FractionBox[
              RowBox[{"i", "-", "2"}], "2"], "*", 
             RowBox[{"f", "[", 
              RowBox[{"i", "-", "2"}], "]"}]}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">", "5"}], "&&", 
             RowBox[{"j", "==", "4"}]}]}], " ", "\[RuleDelayed]", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"f", "[", 
              RowBox[{"i", "-", "3"}], "]"}]}], "*", 
            FractionBox["3", "\[Rho]"]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">", "4"}], "&&", 
             RowBox[{"j", "==", 
              RowBox[{"i", "-", "1"}]}]}]}], "\[RuleDelayed]", "\[Theta]"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">=", "4"}], "&&", 
             RowBox[{"j", "==", 
              RowBox[{"i", "+", "1"}]}]}]}], " ", "\[RuleDelayed]", "i"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Mx", "+", "1"}], ",", 
          RowBox[{"Mx", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"transportMatrix", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "i_"}], "}"}], "\[RuleDelayed]", "u"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "\[RuleDelayed]", "\[Rho]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}], "\[RuleDelayed]", 
           FractionBox["\[Theta]", "\[Rho]"]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], "\[RuleDelayed]", "1"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "2"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"2", "*", "\[Theta]"}]}]}], "\[IndentingNewLine]", "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Mx", "+", "1"}], ",", 
          RowBox[{"Mx", "+", "1"}]}], "}"}]}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9693434654122505`*^9, 3.969343469947525*^9}, {
