Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"u", "\[Rho]", "0", "0", "0", "0", "0", "0", "0"},
     {
      FractionBox["\[Theta]", "\[Rho]"], "u", "1", "0", "0", "0", "0", "0", 
      "0"},
     {"0", 
      RowBox[{"2", " ", "\[Theta]"}], "u", 
      FractionBox["6", "\[Rho]"], "0", "0", "0", "0", "0"},
     {"0", 
      RowBox[{"4", " ", 
       RowBox[{"f", "[", "3", "]"}]}], 
      FractionBox[
       RowBox[{"\[Rho]", " ", "\[Theta]"}], "2"], "u", "4", "0", "0", "0", 
      "0"},
     {
