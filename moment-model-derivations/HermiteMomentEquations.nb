           RowBox[{
            RowBox[{"-", 
             RowBox[{"f", "[", 
              RowBox[{"i", "-", "3"}], "]"}]}], "*", 
            FractionBox["3", "\[Rho]"]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
