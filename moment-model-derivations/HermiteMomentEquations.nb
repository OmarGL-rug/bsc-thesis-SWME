     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[Theta]", " ", 
         RowBox[{"f", "[", "6", "]"}]}], "\[Rho]"]}], 
      RowBox[{"8", " ", 
       RowBox[{"f", "[", "7", "]"}]}], 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "\[Theta]", " ", 
