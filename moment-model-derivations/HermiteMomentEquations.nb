      "0", "0"},
     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[Theta]", " ", 
         RowBox[{"f", "[", "5", "]"}]}], "\[Rho]"]}], 
      RowBox[{"7", " ", 
       RowBox[{"f", "[", "6", "]"}]}], 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "\[Theta]", " ", 
