Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"u", "\[Rho]", "0", "0", "0", "0", "0", "0", "0", "0"},
     {
      FractionBox["\[Theta]", "\[Rho]"], "u", "1", "0", "0", "0", "0", "0", 
      "0", "0"},
     {"0", 
      RowBox[{"2", " ", "\[Theta]"}], "u", 
      FractionBox["6", "\[Rho]"], "0", "0", "0", "0", "0", "0"},
     {"0", 
      RowBox[{"4", " ", 
       RowBox[{"f", "[", "3", "]"}]}], 
      FractionBox[
       RowBox[{"\[Rho]", " ", "\[Theta]"}], "2"], "u", "4", "0", "0", "0", 
      "0", "0"},
     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[Theta]", " ", 
         RowBox[{"f", "[", "3", "]"}]}], "\[Rho]"]}], 
      RowBox[{"5", " ", 
       RowBox[{"f", "[", "4", "]"}]}], 
      FractionBox[
       RowBox[{"3", " ", 
        RowBox[{"f", "[", "3", "]"}]}], "2"], "\[Theta]", "u", "5", "0", "0", 
      "0", "0"},
     {
      RowBox[{"-", 
