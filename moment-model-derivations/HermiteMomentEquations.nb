           RowBox[{"{", 
            RowBox[{"3", ",", "4"}], "}"}], "\[RuleDelayed]", 
           FractionBox["6", "\[Rho]"]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"4", ",", "3"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"\[Rho]", "*", 
            FractionBox["\[Theta]", "2"]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">=", "4"}], "&&", 
             RowBox[{"j", "==", "1"}]}]}], " ", "\[RuleDelayed]", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"f", "[", 
              RowBox[{"i", "-", "2"}], "]"}]}], "*", 
            FractionBox["\[Theta]", "\[Rho]"]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{
             RowBox[{"i", ">=", "4"}], "&&", 
             RowBox[{"j", "==", "2"}]}]}], " ", "\[RuleDelayed]", 
           RowBox[{"i", "*", 
            RowBox[{"f", "[", 
             RowBox[{"i", "-", "1"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
