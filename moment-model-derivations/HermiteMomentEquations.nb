   RowBox[{"hermite", "[", "x_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Mx", "+", "1"}], "2"]}]], 
    RowBox[{"HermiteH", "[", 
     RowBox[{
      RowBox[{"Mx", "+", "1"}], ",", 
      FractionBox["x", 
       RowBox[{"Sqrt", "[", "2", "]"}]]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"hermite", "[", "x", "]"}], "]"}], ",", "x"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"NSolve", "[", 
