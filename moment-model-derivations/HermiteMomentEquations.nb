      RowBox[{"6", " ", 
       RowBox[{"f", "[", "5", "]"}]}], 
      RowBox[{"2", " ", 
       RowBox[{"f", "[", "4", "]"}]}], 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"3", " ", 
         RowBox[{"f", "[", "3", "]"}]}], "\[Rho]"]}], "\[Theta]", "u", "6", 
      "0", "0", "0"},
     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[Theta]", " ", 
         RowBox[{"f", "[", "5", "]"}]}], "\[Rho]"]}], 
      RowBox[{"7", " ", 
       RowBox[{"f", "[", "6", "]"}]}], 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "\[Theta]", " ", 
        RowBox[{"f", "[", "3", "]"}]}], "+", 
       FractionBox[
        RowBox[{"5", " ", 
         RowBox[{"f", "[", "5", "]"}]}], "2"]}], 
      RowBox[{"-", 
