Cell[BoxData[{
 RowBox[{
  RowBox[{"MxNew", "=", 
   RowBox[{"Mx", "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"moments", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3", ",", "MxNew"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "0", "]"}], ":=", "\[Rho]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "1", "]"}], ":=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "2", "]"}], ":=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"MxNew", "+", "1"}], "]"}], ":=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vars", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "u", ",", "\[Theta]"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "3"}], ",", 
    RowBox[{"i", "<=", "MxNew"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"vars", ",", 
      RowBox[{"f", "[", "i", "]"}]}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MxNew", ">", "2"}], ",", 
    RowBox[{
     RowBox[{"transportMatrixAugmented", "=", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "i_"}], "}"}], "\[RuleDelayed]", "u"}], ",", 
